---
import { getCollection } from "astro:content";
import CompetitionPage from "@components/CompetitionPage.astro";
import TournamentPage from "@components/TournamentPage.astro";
import { showCompetition } from "@config/features";

export async function getStaticPaths() {
  if (!showCompetition) return [];

  const tournaments = await getCollection("tournaments");
  return [
    { params: { slug: undefined }, props: { id: null } },
    ...tournaments.map((entry) => ({
      params: { slug: entry.data.id },
      props: { id: entry.data.id },
    })),
  ];
}

const { id } = Astro.props;
---

{id ? <TournamentPage id={id} /> : <CompetitionPage />}

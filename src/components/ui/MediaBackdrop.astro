---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt?: string;
  sizes?: string;
  priority?: boolean;

  position?: string;

  scrim?: "stage" | "bottom" | "even";

  tint?: number;
  class?: string;
}

const {
  src,
  alt = "",
  sizes = "100vw",
  priority = false,
  position = "center",
  scrim = "stage",
  tint = 14,
  class: klass = "",
} = Astro.props;

const D = "6 8 15";
const scrims: Record<string, string> = {
  stage: `linear-gradient(to bottom, rgb(${D} / 0.72) 0%, rgb(${D} / 0.12) 15%, transparent 26%),
          linear-gradient(to top, rgb(${D} / 0.96) 0%, rgb(${D} / 0.9) 20%, rgb(${D} / 0.68) 38%, rgb(${D} / 0.28) 60%, transparent 84%)`,
  bottom: `linear-gradient(to top, rgb(${D} / 0.95) 0%, rgb(${D} / 0.8) 26%, rgb(${D} / 0.4) 52%, rgb(${D} / 0.1) 76%)`,
  even: `linear-gradient(to top, rgb(${D} / 0.88) 0%, rgb(${D} / 0.7) 50%, rgb(${D} / 0.62) 100%)`,
};
---

<div class={`absolute inset-0 overflow-hidden ${klass}`}>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1024, 1440, 1920, 2560]}
    sizes={sizes}
    format="webp"
    quality={70}
    class="size-full object-cover"
    style={`object-position:${position}`}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    {...(priority ? { fetchpriority: "high" } : {})}
  />
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style={`background:${scrims[scrim]}, color-mix(in srgb, #1d3c87 ${tint}%, transparent)`}
  >
  </div>
</div>

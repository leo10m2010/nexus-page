---

interface Props {
  id?: string;
  labelledby?: string;
  ariaLabel?: string;

  spacing?: "none" | "tight" | "default";
  bordered?: boolean;
  class?: string;
  innerClass?: string;
}

const {
  id,
  labelledby,
  ariaLabel,
  spacing = "default",
  bordered = false,
  class: klass = "",
  innerClass = "",
} = Astro.props;

const pad = {
  none: "",
  tight: "py-7",
  default: "py-24 sm:py-32",
}[spacing];
---

<section
  id={id}
  aria-labelledby={labelledby}
  aria-label={ariaLabel}
  class={`${bordered ? "border-t border-line" : ""} ${pad} ${klass}`}
>
  <div class={`mx-auto w-full max-w-[1400px] px-5 sm:px-8 ${innerClass}`}>
    <slot />
  </div>
</section>

---
/* The "NEXUS" lettering only, extracted from the same source as
   NexusMark.astro (public/logos/white.svg) — no icon, no "SERIES" subtitle,
   no divider rule. For decorative uses that want the brand's own letterforms
   instead of a typed word in a display font. Two fills, same convention as
   NexusMark: the X's diagonal carries the brand blue, everything else
   follows body text so it still reads in both themes. */
interface Props {
  class?: string;
  style?: string;
}
const { class: klass = "", style } = Astro.props;

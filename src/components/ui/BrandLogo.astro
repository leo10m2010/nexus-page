---

interface Props {
  height?: number;
  class?: string;
}
const { height = 26, class: klass = "" } = Astro.props;
---

<span
  class={`brand-logo block ${klass}`}
  style={`height:${height}px;width:${(height * 3.145).toFixed(1)}px`}
  role="img"
  aria-label="Nexus Series"
>
</span>

<style>
  .brand-logo {
    background-image: var(--logo-src);
    background-size: contain;
    background-position: left center;
    background-repeat: no-repeat;
  }
</style>

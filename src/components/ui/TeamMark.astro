---
import type { Team } from "@lib/competition";
import UniversalMark from "@ui/UniversalMark.astro";

interface Props {
  team: Team | null;
  size?: number;
  class?: string;
}
const { team, size = 44, class: klass = "" } = Astro.props;
const box = `width:${size}px;height:${size}px`;
---

{
  team === null ? (
    <span
      aria-hidden="true"
      class={`block shrink-0 rounded-control border border-dashed border-line-strong ${klass}`}
      style={box}
    />
  ) : team.logo ? (
    <img
      src={team.logo}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      class={`shrink-0 rounded-control object-contain ${klass}`}
      style={box}
    />
  ) : (
    <span
      aria-hidden="true"
      class={`grid shrink-0 place-items-center rounded-control border border-line-strong bg-elev2 ${klass}`}
      style={box}
    >
      <UniversalMark style={`width:${Math.round(size * 0.55)}px;height:${Math.round(size * 0.55)}px`} />
    </span>
  )
}

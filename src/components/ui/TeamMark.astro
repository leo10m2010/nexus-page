---
import type { Team } from "@lib/competition";
import UniversalMark from "@ui/UniversalMark.astro";

/* A team either has a real logo file or it gets the Dota 2 glyph in a
   neutral tone. That glyph is a placeholder, not an invented emblem: it
   should read as "no logo yet", not as somebody's actual brand.

   `null` is a slot in a bracket that nobody has qualified for yet. It gets a
   dashed square, so an empty line reads as waiting rather than as broken. */
interface Props {
  team: Team | null;
  size?: number;
  class?: string;
}
const { team, size = 44, class: klass = "" } = Astro.props;
const box = `width:${size}px;height:${size}px`;
---

{
  team === null ? (
    <span
      aria-hidden="true"
      class={`block shrink-0 border border-dashed border-line-strong ${klass}`}
      style={box}
    />
  ) : team.logo ? (
    <img
      src={team.logo}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      class={`shrink-0 object-contain ${klass}`}
      style={box}
    />
  ) : (
    <span
      aria-hidden="true"
      class={`grid shrink-0 place-items-center border border-line-strong bg-elev2 ${klass}`}
      style={box}
    >
      <UniversalMark style={`width:${Math.round(size * 0.55)}px;height:${Math.round(size * 0.55)}px`} />
    </span>
  )
}

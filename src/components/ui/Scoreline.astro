---
import TeamMark from "@ui/TeamMark.astro";
import type { ResolvedMatch } from "@lib/competition";

/* Shared between the schedule and the results, so a fixture always reads the
   same way. `score` decides whether it shows a result or a kickoff slot. */
interface Props {
  match: ResolvedMatch;
  /** Right-hand content: a time for upcoming, the score for played. */
  trailing?: string;
}
const { match, trailing } = Astro.props;
const [homeScore, awayScore] = match.score ?? [];
const homeWon = match.score ? homeScore! > awayScore! : false;
const awayWon = match.score ? awayScore! > homeScore! : false;
---

<div class="flex items-center gap-4 sm:gap-6">
  <div class="flex min-w-0 flex-1 items-center gap-3">
    <TeamMark team={match.home} size={36} />
    <span class={`truncate text-[0.9375rem] ${homeWon ? "text-ink" : "text-muted"}`}>
      {match.home.name}
    </span>
  </div>

  {
    match.score ? (
      <span class="display-sm shrink-0 text-xl tabular-nums sm:text-2xl">
        <span class={homeWon ? "text-ink" : "text-muted"}>{homeScore}</span>
        <span class="px-1.5 text-muted">:</span>
        <span class={awayWon ? "text-ink" : "text-muted"}>{awayScore}</span>
      </span>
    ) : (
      <span class="display-sm shrink-0 text-sm text-accent-lift tabular-nums">{trailing}</span>
    )
  }

  <div class="flex min-w-0 flex-1 items-center justify-end gap-3">
    <span class={`truncate text-right text-[0.9375rem] ${awayWon ? "text-ink" : "text-muted"}`}>
      {match.away.name}
    </span>
    <TeamMark team={match.away} size={36} />
  </div>
</div>

---
import Base from "@layouts/Base.astro";
import Nav from "@layout/Nav.astro";
import Footer from "@layout/Footer.astro";
import SectionNav from "@ui/SectionNav.astro";
import Header from "@sections/tournament/Header.astro";
import PrizesFormat from "@sections/tournament/PrizesFormat.astro";
import Participants from "@sections/tournament/Participants.astro";
import Standings from "@sections/tournament/Standings.astro";
import Bracket from "@sections/tournament/Bracket.astro";
import Fixtures from "@sections/tournament/Fixtures.astro";
import Talent from "@sections/tournament/Talent.astro";
import { site } from "@config/site";
import { features } from "@config/features";
import { useTranslations, resolveLocale } from "@lib/i18n";
import { formatDateRange } from "@lib/format";
import {
  getBracket,
  getGroups,
  getMatches,
  getParticipants,
  getTournament,
  getTournamentFormats,
  getTournamentTeamCount,
} from "@lib/competition";

interface Props {
  id: string;
}
const { id } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const tournament = await getTournament(id);
const [participants, groups, bracket, matches] = await Promise.all([
  getParticipants(tournament),
  getGroups(id),
  getBracket(id),
  getMatches(id),
]);

const phases = tournament.phases ?? [];
const hasMatches = matches.some((m) => m.home && m.away);
const talent = tournament.broadcastTalent ?? [];
const teamCount = getTournamentTeamCount(tournament);

const sections = [
  { id: "prizes", label: c.info.prizePool, show: tournament.prizePool != null },
  { id: "format", label: c.section.format, show: phases.length > 0 },
  { id: "participants", label: c.section.participants, show: participants.length > 0 },
  { id: "standings", label: c.section.standings, show: groups.length > 0 },
  { id: "bracket", label: c.section.bracket, show: bracket.length > 0 },
  { id: "matches", label: c.section.matches, show: hasMatches },
  { id: "talent", label: c.section.talent, show: talent.length > 0 },
].filter((s) => s.show);

const description = [
  tournament.name,
  formatDateRange(tournament.startDate, tournament.endDate, locale),
  getTournamentFormats(tournament).map((format) => c.format[format]).join(" + "),
  teamCount == null ? null : c.teamCount(teamCount),
].filter(Boolean).join(" - ");
---

<Base
  title={`${tournament.name} | ${site.name}`}
  description={description}
  noindex={!features.competition.published}
>
  <Nav />
  <main id="main">
    <Header tournament={tournament} />
    <SectionNav items={sections} ariaLabel={tournament.name} />

    {
      (tournament.prizePool || phases.length > 0) && (
        <PrizesFormat tournament={tournament} phases={phases} />
      )
    }
    {
      participants.length > 0 && (
        <Participants id="participants" participants={participants} />
      )
    }
    {groups.length > 0 && <Standings id="standings" groups={groups} />}
    {bracket.length > 0 && <Bracket id="bracket" sides={bracket} />}
    {hasMatches && <Fixtures id="matches" matches={matches} />}
    {talent.length > 0 && <Talent id="talent" tournament={tournament} />}
  </main>
  <Footer />
</Base>

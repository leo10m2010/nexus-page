---
import { Icon } from "astro-icon/components";
import BrandLogoMono from "@ui/BrandLogoMono.astro";
import LocaleSwitcher from "@layout/LocaleSwitcher.astro";
import { social } from "@config/site";
import { showCompetition } from "@config/features";
import { localePath, resolveLocale, useTranslations } from "@lib/i18n";
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localePath(locale);
const isHome = Astro.url.pathname === home;
const section = (id: string) => isHome ? `#${id}` : `${home}#${id}`;
const labels = { es: { watch: "EN VIVO", partners: "PARTNERS" }, en: { watch: "WATCH", partners: "PARTNERS" }, ru: { watch: "ЭФИР", partners: "ПАРТНЁРЫ" } }[locale];
---
<header class:list={["brand-header", { "brand-header--overlay": overlay }]}>
  <nav class="brand-nav" aria-label={t.a11y.primaryNav}>
    <div class="brand-nav-left"><div class="brand-social"><a href={social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:instagram" /></a><a href={social.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:facebook" /></a><a href={social.discord} aria-label="Discord" target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:discord" /></a></div>{showCompetition && <a class="brand-desktop-link" href={section("teams-showcase")}>{t.competition.teams}</a>}<a class="brand-desktop-link" href={section("channels")}>{labels.watch}</a></div>
    <a href={section("home")} class="brand-seal" aria-label={t.a11y.backToTop}><BrandLogoMono height={32} /></a>
    <div class="brand-nav-right"><a class="brand-desktop-link" href={section("partners")}>{labels.partners}</a>{showCompetition && <a class="brand-desktop-link" href={`${home}competition/`}>{t.competition.navLabel}</a>}<LocaleSwitcher /><button class="brand-menu-toggle" data-menu-toggle data-label-open={t.a11y.openMenu} data-label-close={t.a11y.closeMenu} aria-label={t.a11y.openMenu} aria-expanded="false" aria-controls="mobile-menu"><Icon name="ph:list" /></button></div>
  </nav>
  <nav id="mobile-menu" class="brand-mobile-menu" aria-label={t.a11y.primaryNav} hidden inert>
    {showCompetition && <><a href={`${home}competition/`}>{t.competition.navLabel}</a><a href={section("teams-showcase")}>{t.competition.teams}</a></>}<a href={section("partners")}>{labels.partners}</a><a href={section("channels")}>{labels.watch}</a><a href={section("about")}>{t.nav.about}</a><a href={`${home}mediakit/`}>{t.cta.partnership}</a>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.brand-menu-toggle');
  const menu = document.querySelector<HTMLElement>('.brand-mobile-menu');
  function setMenu(open: boolean) { if (!button || !menu) return; menu.hidden = !open; menu.inert = !open; button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? 'Menu'); }
  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') { setMenu(false); button.focus(); } });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => { if (event.matches) setMenu(false); });
</script>
<style>
  .brand-header { position: fixed; inset: 0 0 auto; z-index: 50; background: var(--c-bg); border-bottom: 1px solid var(--c-line); }
  .brand-header--overlay { position: relative; z-index: 2; background: transparent; border: 0; color: #f2f4f6; }
  .brand-nav { display: grid; grid-template-columns: 1fr 150px 1fr; align-items: center; height: 68px; padding-inline: 4.7%; gap: 20px; }
  .brand-header--overlay .brand-nav { height: 82px; }
  .brand-nav-left, .brand-nav-right, .brand-social { display: flex; align-items: center; gap: 30px; }
  .brand-social { gap: 13px; } .brand-nav-right { justify-content: flex-end; }
  .brand-nav a:not(.brand-seal) { font-family: var(--font-poster); font-size: 17px; text-transform: uppercase; white-space: nowrap; }
  .brand-nav a:hover { color: var(--c-accent-lift); }
  .brand-social a { display: grid; place-items: center; min-height: 36px; }
  .brand-social svg { width: 16px; height: 16px; }
  .brand-seal { align-self: start; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 28px; height: 118px; width: 150px; margin-top: -35px; border-radius: 0 0 50% 50%; background: #f2f4f6; color: #0b1015; }
  .brand-header--overlay .brand-seal { height: 128px; padding-bottom: 32px; }
  .brand-nav :global([data-theme-toggle]), .brand-nav :global([data-locale-toggle]) { border: 0; padding-inline: 4px; }
  .brand-header--overlay :global([data-theme-toggle]), .brand-header--overlay :global([data-locale-toggle]) { color: #e6edf4; }
  .brand-nav :global(.locale-menu) { color: var(--c-text); }
  .brand-menu-toggle { display: none; }
  .brand-mobile-menu:not([hidden]) { position: absolute; top: 68px; right: 15px; left: 15px; display: grid; padding: 15px 24px; background: var(--c-bg-elev); color: var(--c-text); border: 1px solid var(--c-line-strong); }
  .brand-mobile-menu a { padding: 10px 0; font-size: 16px; }
  @media (max-width: 1200px) { .brand-nav { gap: 10px; padding-inline: 30px; } .brand-nav-left, .brand-nav-right { gap: 18px; } .brand-nav a:not(.brand-seal) { font-size: 15px; } }
  @media (max-width: 1023px) { .brand-desktop-link { display: none; } .brand-menu-toggle { display: grid; place-items: center; width: 34px; height: 40px; } .brand-menu-toggle svg { width: 21px; height: 21px; } .brand-nav-right { gap: 7px; } }
  @media (max-width: 767px) { .brand-nav { padding-inline: 20px; grid-template-columns: 1fr 95px 1fr; gap: 4px; } .brand-header--overlay .brand-nav { height: 75px; } .brand-social { gap: 11px; } .brand-social a:nth-child(2) { display: none; } .brand-social svg { width: 14px; height: 14px; } .brand-nav-right { gap: 2px; } .brand-nav :global([data-locale-toggle]) { gap: 3px; } .brand-nav :global([data-theme-toggle]) { width: 28px; } .brand-seal, .brand-header--overlay .brand-seal { width: 95px; height: 108px; padding-bottom: 23px; } .brand-seal :global(.brand-logo-mono) { max-width: 75px; } }
</style>

---
import { Icon } from "astro-icon/components";
import { useTranslations } from "@lib/i18n";

const t = useTranslations(Astro.currentLocale);
---

<button
  type="button"
  data-theme-toggle
  class="grid size-10 place-items-center border border-line text-muted transition-colors hover:border-line-strong hover:text-ink"
  aria-label={t.a11y.switchTheme}
>
  <Icon name="ph:sun-bold" class="dark-only size-[18px]" />
  <Icon name="ph:moon-bold" class="light-only size-[18px]" />
</button>

<style>
  /* Icon visibility mirrors the token strategy in tokens.css. */
  :global(:root) .dark-only { display: block; }
  :global(:root) .light-only { display: none; }
  :global(:root[data-theme="light"]) .dark-only { display: none; }
  :global(:root[data-theme="light"]) .light-only { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .dark-only { display: none; }
    :global(:root:not([data-theme="dark"])) .light-only { display: block; }
  }
</style>

<script>
  import { toggleTheme } from "@lib/theme";
  document
    .querySelector("[data-theme-toggle]")
    ?.addEventListener("click", () => toggleTheme());
</script>

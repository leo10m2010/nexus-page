---
import { sameAs, site, social } from "@config/site";
import { localeMeta, locales, localizePath, resolveLocale } from "@lib/i18n";

interface Props {
  title: string;
  description: string;

  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);

const path = Astro.url.pathname;
const canonical = new URL(path, site.url);
const ogImage = new URL(site.ogImage, site.url);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  description,
  email: site.email,
  sameAs,
};
---

{noindex && <meta name="robots" content="noindex, nofollow" />}
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  locales.map((l) => (
    <link
      rel="alternate"
      hreflang={localeMeta[l].htmlLang}
      href={new URL(localizePath(path, l), site.url)}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL("/", site.url)} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{
  locales
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)
}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(site.ogImageSize.width)} />
<meta property="og:image:height" content={String(site.ogImageSize.height)} />
<meta property="og:image:alt" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={social.xHandle} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

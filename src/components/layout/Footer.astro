---
import { Icon } from "astro-icon/components";
import BrandLogo from "@ui/BrandLogo.astro";
import SocialLinks from "@ui/SocialLinks.astro";
import { site, contactRoutes, channels } from "@config/site";
import { navItems } from "@config/nav";
import { showCompetition } from "@config/features";
import { localePath, resolveLocale, useTranslations } from "@lib/i18n";
import type { ChannelCode } from "@types";

const t = useTranslations(Astro.currentLocale);
const locale = resolveLocale(Astro.currentLocale);
const homePath = localePath(locale);
const homeHref = Astro.url.pathname === homePath ? "#home" : `${homePath}#home`;
const sectionHref = (hash: string) => (Astro.url.pathname === homePath ? hash : `${homePath}${hash}`);
const competitionHref = `${homePath}competition/`.replace("//", "/");
const channelHandle = (href: string) => new URL(href).pathname.replace(/^\/+|\/+$/g, "");

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-elev">
  <div class="mx-auto grid max-w-[1400px] gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-8">
    <div class="max-w-[28ch]">
      <a href={homeHref} class="brand inline-block" aria-label={t.a11y.backToTop}>
        <BrandLogo height={32} />
      </a>
      <p class="mt-5 text-[0.9375rem] text-muted">{site.tagline}</p>
      <SocialLinks class="-ml-2.5 mt-6" />
    </div>

    <nav aria-label={t.footer.navHeading}>
      <h3 class="eyebrow">{t.footer.navHeading}</h3>
      <ul class="mt-5 flex flex-col gap-3">
        {
          navItems.map((l) => (
            <li>
              <a href={sectionHref(l.href)} class="footer-link text-[0.9375rem] text-muted">
                {t.nav[l.key]}
              </a>
            </li>
          ))
        }
        {
          showCompetition && (
            <li>
              <a href={competitionHref} class="footer-link text-[0.9375rem] text-muted">
                {t.competition.navLabel}
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <div>
      <h3 class="eyebrow">{t.contact.eyebrow}</h3>
      <ul class="mt-5 flex flex-col gap-3">
        {
          contactRoutes.map((r) => (
            <li>
              <a
                href={r.href}
                class="footer-link inline-flex items-center gap-2 text-[0.9375rem] text-muted"
                {...(r.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <Icon name={r.icon} class="size-4 shrink-0" />
                {r.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="eyebrow">{t.footer.watchHeading}</h3>
      <ul class="watch-list mt-4">
        {
          channels.map((c) => (
            <li class="watch-item">
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="watch-link"
              >
                <Icon name={`flag:${c.flag}-4x3`} class="watch-flag" aria-hidden="true" />
                <span class="min-w-0">
                  <strong>{t.channels.languages[c.code.toLowerCase() as ChannelCode]}</strong>
                  <span>@{channelHandle(c.href)}</span>
                </span>
                <Icon name="simple-icons:twitch" class="watch-platform" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-[1400px] px-5 py-6 text-sm text-muted sm:px-8">
      &copy; {year} {site.name}. {t.footer.rights}
    </p>
  </div>
</footer>

<style>
  .brand { transition: transform 0.25s var(--ease-out-quint); }
  .brand:active { transform: scale(0.96); }

  .footer-link {
    position: relative;
    width: fit-content;
    transition: color 0.2s var(--ease-out-quint);
  }
  .footer-link::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    background: var(--c-accent-lift);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out-quint);
  }
  .footer-link:hover { color: var(--c-text); }
  .footer-link:hover::after { transform: scaleX(1); }

  .watch-list { border-top: 1px solid var(--c-line); }
  .watch-item { border-bottom: 1px solid var(--c-line); }

  .watch-link {
    display: grid;
    width: 100%;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.75rem;
    color: var(--c-text-muted);
    transition: color 0.2s var(--ease-out-quint), padding-left 0.25s var(--ease-out-quint);
  }

  .watch-flag {
    width: 1.5rem;
    height: 1.125rem;
    border: 1px solid var(--c-line-strong);
  }

  .watch-link strong,
  .watch-link span span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .watch-link strong {
    color: var(--c-text);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .watch-link span span { margin-top: 0.125rem; font-size: 0.6875rem; }

  .watch-platform {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--c-text-muted);
    transition: color 0.2s var(--ease-out-quint);
  }

  .watch-link:hover { padding-left: 0.25rem; color: var(--c-text); }
  .watch-link:hover .watch-platform { color: #9146ff; }

  .watch-link:focus-visible {
    outline: 2px solid var(--c-accent-lift);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand:active { transform: none; }
    .footer-link::after { transition: none; }
    .watch-link,
    .watch-platform { transition: none; }
    .watch-link:hover { padding-left: 0; }
  }
</style>

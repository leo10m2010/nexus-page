---
import BrandLogoMono from "@ui/BrandLogoMono.astro";
import SocialLinks from "@ui/SocialLinks.astro";
import { site } from "@config/site";
import { showCompetition } from "@config/features";
import { localePath, resolveLocale, useTranslations } from "@lib/i18n";
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = localePath(locale);
const section = (id: string) => Astro.url.pathname === home ? `#${id}` : `${home}#${id}`;
const partners = { es: "Partners", en: "Partners", ru: "Партнёры" }[locale];
---
<footer class="brand-footer">
  <a href={section("home")} aria-label={t.a11y.backToTop}><BrandLogoMono height={40} /></a>
  <nav aria-label={t.footer.navHeading}><a href={section("home")}>{t.nav.home}</a>{showCompetition && <a href={`${home}competition/`}>{t.competition.navLabel}</a>}<a href={section("partners")}>{partners}</a><a href={section("about")}>{t.nav.about}</a><a href={`${home}mediakit/`}>{t.cta.partnership}</a><a href={section("contact")}>{t.nav.contact}</a></nav>
  <SocialLinks /><p>© {new Date().getFullYear()} {site.name}. {t.footer.rights}</p>
</footer>
<style>
  .brand-footer { display: flex; flex-direction: column; align-items: center; gap: 23px; padding: 30px 24px 25px; background: var(--c-bg); border-top: 1px solid var(--c-line); }
  .brand-footer nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px 25px; }
  .brand-footer nav a { font-size: 12px; color: var(--c-text-muted); }
  .brand-footer nav a:hover { color: var(--c-accent-lift); }
  .brand-footer > p { font-size: 10px; color: var(--c-text-muted); text-align: center; }
</style>

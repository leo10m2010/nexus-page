---
import Base from "@layouts/Base.astro";
import Nav from "@layout/Nav.astro";
import Footer from "@layout/Footer.astro";
import PageHero from "@ui/PageHero.astro";
import Tournaments from "@sections/Tournaments.astro";
import Schedule from "@sections/Schedule.astro";
import Results from "@sections/Results.astro";
import Teams from "@sections/Teams.astro";
import { site } from "@config/site";
import { useTranslations } from "@lib/i18n";
import { features } from "@config/features";

const t = useTranslations(Astro.currentLocale);
const c = t.competition;
---

<Base
  title={`${c.heading.replace(/\.$/, "")} | ${site.name}`}
  description={c.lede}
  noindex={!features.competition.published}
>
  <Nav />
  <main id="main">
    <PageHero title={c.heading} description={c.lede} />

    <Tournaments />
    <Schedule />
    <Results />
    <Teams />
  </main>
  <Footer />
</Base>

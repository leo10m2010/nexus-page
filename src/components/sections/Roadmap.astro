---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import Eyebrow from "@ui/Eyebrow.astro";
import NexusWordmark from "@ui/NexusWordmark.astro";
import StageCard from "./roadmap/StageCard.astro";
import { getRoadmapStages, ROMAN_NUMERALS } from "@lib/roadmap";
import { formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

/* Shared with the header's tournament panel via lib/roadmap.ts, so the two
   can never disagree about what the current season looks like. */
const stages = await getRoadmapStages(locale);
const totalPrize = stages.reduce((sum, s) => sum + s.prizeTotal, 0);
---

<Section id="roadmap" bordered class="relative isolate overflow-hidden">
  {/* The warm glow from the tournament-announcement graphic, carried onto the
      page: a soft gold field that drifts slowly behind the section instead of
      sitting still. Full-bleed via the escape-the-container trick, since the
      section's own content column is capped at 1400px; `isolate` on the
      section keeps the negative z-index from reaching outside it. */}
  <div class="gold-glow pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen" aria-hidden="true" />

  {/* The other half of that same graphic language: a huge tilted wordmark
      sitting behind the section, the way EPL runs its own name ghosted
      behind a panel. The brand's own lettering, lifted straight from the
      logo file — not typed in a display font — same as everywhere else
      "NEXUS" appears as a graphic rather than as a word. */}
  <div class="wordmark pointer-events-none absolute inset-0 -z-10 flex items-center overflow-hidden select-none" aria-hidden="true">
    {/* `--word-brand: currentColor` makes the X's usual blue diagonal follow
        the same white as the rest of the letters — a flat mark for a ghost
        texture, not the two-tone logo. Custom properties inherit through
        the DOM regardless of component scoping, so this is the one thing
        here that is safe to set directly on the child; width/opacity/
        rotation are not (see the :global() note below). */}
    <NexusWordmark class="wordmark-svg text-ink" style="--word-brand: currentColor" />
  </div>

  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
    <div class="max-w-[26ch]">
      <Eyebrow text={t.roadmap.eyebrow} class="reveal" />
      <h2 class="display reveal mt-4 text-[clamp(1.75rem,3.4vw,2.75rem)]" style="--reveal-delay:40ms">
        {t.roadmap.heading}
      </h2>
    </div>
    <p class="lede reveal max-w-[42ch]" style="--reveal-delay:90ms">{t.roadmap.lede}</p>
  </div>

  {/* Each card cuts its own corner now, so it does not share a hairline
      border with its neighbours the way a plain rectangular card would. */}
  <div class="mt-14 grid gap-4 md:grid-cols-3">
    {
      stages.map((stage, i) => (
        <div class="reveal" style={`--reveal-delay:${140 + i * 70}ms`}>
          <StageCard stage={stage} numeral={ROMAN_NUMERALS[i]!} />
        </div>
      ))
    }
  </div>

  <div class="reveal mt-14 flex flex-wrap items-center gap-3 border-t border-line pt-8" style="--reveal-delay:380ms">
    <Icon name="ph:trophy-fill" class="size-5 shrink-0 text-accent-lift" />
    <p class="text-[0.9375rem] text-muted">
      {t.roadmap.totalPrizePool}
      <span class="ml-2 font-display text-lg font-bold text-ink">{formatMoney(totalPrize, "USD", locale)}</span>
    </p>
  </div>
</Section>

<style>
  .gold-glow {
    transform: translateX(-50%);
    background: radial-gradient(
      50% 60% at 80% 15%,
      color-mix(in srgb, var(--c-accent) 30%, transparent) 0%,
      transparent 72%
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .gold-glow { animation: gold-drift 18s ease-in-out infinite alternate; }
  }

  @keyframes gold-drift {
    from { transform: translateX(-50%) translateY(-3%) scale(1); }
    to { transform: translateX(-50%) translateY(5%) scale(1.12); }
  }

  /* `:global()`, not a plain scoped selector: NexusWordmark is a child
     component, so its root <svg> never carries this component's scope id —
     a scoped `.wordmark-svg { ... }` rule silently matches nothing, which
     is exactly how this shipped at full opacity, full size, no rotation:
     the markup was right, this rule just never touched the element it
     names, and only actually opening the rendered page (not just reading
     the code) shows that. */
  :global(.wordmark-svg) {
    width: clamp(36rem, 96vw, 80rem);
    flex-shrink: 0;
    opacity: 0.03;
    transform: rotate(-9deg) translate(6%, 6%);
  }
</style>

---
import Section from "@ui/Section.astro";
import Scoreline from "@ui/Scoreline.astro";
import { getResults } from "@lib/competition";
import { formatDate } from "@lib/format";
import { useTranslations } from "@lib/i18n";

const t = useTranslations(Astro.currentLocale);
const results = await getResults();
const locale = Astro.currentLocale;
---

<Section id="results" bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">
    {t.competition.results}
  </h2>

  {
    results.length === 0 ? (
      <p class="lede reveal mt-8">{t.competition.empty}</p>
    ) : (
      /* Card per result rather than table rows, so the scoreline carries the
         weight and the meta line stays quiet above it. */
      <div class="grid-hairline mt-10 grid lg:grid-cols-2">
        {results.map((match, i) => (
          <article class="reveal bg-elev px-6 py-6 sm:px-8" style={`--reveal-delay:${i * 60}ms`}>
            <p class="mb-4 flex flex-wrap items-baseline gap-x-2 text-[0.6875rem] tracking-[0.16em] text-muted uppercase">
              <span>{match.tournament.name}</span>
              <span>/</span>
              <span>{t.competition.stage[match.stage]}</span>
              <span class="ml-auto normal-case tracking-normal">
                {formatDate(match.startsAt, locale)}
              </span>
            </p>
            <Scoreline match={match} />
          </article>
        ))}
      </div>
    )
  }
</Section>

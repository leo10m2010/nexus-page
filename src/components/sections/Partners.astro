---
import Section from "@ui/Section.astro";
import Button from "@ui/Button.astro";
import { ctas } from "@config/site";
import { useTranslations } from "@lib/i18n";

const t = useTranslations(Astro.currentLocale);
const { heading, lede, slotLabel } = t.partners;

const SLOT_COUNT = 3;
const slots = Array.from({ length: SLOT_COUNT }, (_, i) => i + 1);
---

<Section bordered labelledby="partners-heading">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
    <div class="max-w-[46ch]">
      <h2 id="partners-heading" class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">
        {heading}
      </h2>
      <p class="lede reveal mt-5" style="--reveal-delay:70ms">{lede}</p>
    </div>
    <Button {...ctas.partnership} label={t.cta.partnership} variant="ghost" class="reveal shrink-0" />
  </div>

  <div
    class="reveal mt-12 grid gap-4 sm:grid-cols-3"
    style="--reveal-delay:130ms"
  >
    {
      slots.map((n) => (
        <div class="chevron-field card-tile relative grid min-h-[132px] place-items-center rounded-card px-6">
          <span class="display-sm text-center text-[0.8125rem] tracking-[0.2em] text-muted">
            {slotLabel}
          </span>
          <span class="sr-only">{t.a11y.openSlot(n, SLOT_COUNT)}</span>
        </div>
      ))
    }
  </div>
</Section>

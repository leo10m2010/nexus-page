---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { localePath, resolveLocale, useTranslations } from "@lib/i18n";
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const sponsors = (await getCollection("sponsors")).flatMap(entry => entry.data.sponsors).filter(sponsor => sponsor.active);
const title = { es: "Partners", en: "Partners", ru: "Партнёры" }[locale];
// Repeat only real partners. Two identical runs create a seamless wrap.
const repetitions = sponsors.length ? Math.ceil(6 / sponsors.length) : 0;
const run = Array.from({length: repetitions}, () => sponsors).flat();
---
<section id="partners" class="partner-strip" aria-labelledby="partners-heading" data-partner-strip>
  <div class="partner-bar">
    <h2 id="partners-heading">{title}</h2>
    <div class="partner-window">
      {sponsors.length ? [0,1].map(group => <ul class="partner-run" aria-hidden={group === 1 ? "true" : undefined}>
        {run.map((sponsor, index) => {
          const replica = group === 1 || index >= sponsors.length;
          const Tag = sponsor.url ? "a" : "div";
          return <li class="partner-item" aria-hidden={replica ? "true" : undefined}><Tag class="partner-logo" data-surface={sponsor.surface} href={sponsor.url || undefined} target={sponsor.url ? "_blank" : undefined} rel={sponsor.url ? "noopener noreferrer" : undefined} tabindex={replica && sponsor.url ? -1 : undefined} aria-label={!replica && sponsor.url ? `${sponsor.name}: ${t.partners.visitWebsite}` : undefined}><img src={sponsor.logo} alt={replica ? "" : sponsor.name} width="132" height="45" loading="lazy" decoding="async" /></Tag></li>;
        })}
      </ul>) : <p class="partner-empty">{t.partners.slotLabel}</p>}
    </div>
    <div class="partner-controls">
      <div class="partners-pitch"><a href={`${localePath(locale)}mediakit/`}>Media kit <Icon name="ph:arrow-up-right" /></a></div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-partner-strip]').forEach(strip => {
    strip.dataset.motion = 'true';
  });
</script>
<style>
  .partner-strip { width: 100%; border-block: 1px solid var(--c-line); background: var(--c-bg); }
  .partner-bar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 26px; width: min(1440px, calc(100% - 64px)); min-height: 88px; margin-inline: auto; }
  .partner-strip h2 { color: var(--c-text-muted); font: 500 12px/1.4 var(--font-body); }
  .partner-window { display: flex; min-width: 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 30px, #000 calc(100% - 30px), transparent); }
  .partner-run { display: flex; align-items: center; flex-shrink: 0; min-width: 100%; justify-content: space-around; }
  .partner-item { flex: 0 0 auto; padding-inline: 36px; }
  .partner-logo { display: grid; place-items: center; min-height: 66px; }
  .partner-logo img { width: 132px; height: 45px; object-fit: contain; }
  .partner-logo[data-surface="light"] img { filter: brightness(0) invert(1); }
  .partner-controls { display: flex; align-items: center; gap: 16px; }
  .partners-pitch a { display: flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 12px; color: var(--c-text-muted); }
  .partners-pitch a:hover { color: var(--c-accent-lift); }
  .partners-pitch svg { width: 13px; height: 13px; }
  .partner-empty { margin: auto; font-size: 12px; color: var(--c-text-muted); }
  .partner-strip[data-motion="true"] .partner-run { animation: partners-travel 40s linear infinite; }
  .partner-window:hover .partner-run { animation-play-state: paused; }
  .partner-window:focus-within { overflow-x: auto; mask-image: none; }
  .partner-strip[data-motion="true"] .partner-window:focus-within .partner-run { animation: none; transform: none; }
  @keyframes partners-travel { to { transform: translateX(-100%); } }
  @media (max-width: 767px) { .partner-bar { width: calc(100% - 32px); min-height: 76px; gap: 12px; } .partner-strip h2 { font-size: 10px; } .partner-controls { gap: 8px; } .partner-logo img { width: 115px; height: 39px; } .partner-item { padding-inline: 25px; } .partners-pitch a { font-size: 10px; } .partner-window { mask-image: linear-gradient(90deg, transparent, #000 12px, #000 calc(100% - 12px), transparent); } .partner-pause:not([hidden]) { width: 30px; height: 32px; } }
  @media (prefers-reduced-motion: reduce) {
    .partner-strip[data-motion="true"] .partner-run { animation: none; }
    .partner-run[aria-hidden="true"], .partner-item[aria-hidden="true"] { display: none; }
    .partner-run { justify-content: center; }
    .partner-window { overflow-x: auto; mask-image: none; }
  }
</style>

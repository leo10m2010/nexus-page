---
import Section from "@ui/Section.astro";
import Button from "@ui/Button.astro";
import { ctas } from "@config/site";
import { useTranslations } from "@lib/i18n";

const t = useTranslations(Astro.currentLocale);
const { heading, lede, slotLabel } = t.partners;

/* Three open slots, mirroring the sponsor board on the previous site. */
const SLOT_COUNT = 3;
const slots = Array.from({ length: SLOT_COUNT }, (_, i) => i + 1);
---

<Section bordered labelledby="partners-heading">
  <h2 id="partners-heading" class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">
    {heading}
  </h2>
  <p class="lede reveal mt-5" style="--reveal-delay:70ms">{lede}</p>

  {/* Sponsor board: one strip, hairline-divided, waiting to be filled. */}
  <div
    class="reveal mt-12 grid gap-px border border-line bg-line sm:grid-cols-3"
    style="--reveal-delay:130ms"
  >
    {
      slots.map((n) => (
        <div class="chevron-field relative grid min-h-[132px] place-items-center bg-elev px-6">
          <span class="display-sm text-center text-[0.8125rem] tracking-[0.2em] text-muted">
            {slotLabel}
          </span>
          <span class="sr-only">{t.a11y.openSlot(n, SLOT_COUNT)}</span>
        </div>
      ))
    }
  </div>

  <Button {...ctas.partnership} label={t.cta.partnership} variant="ghost" class="reveal mt-8" />
</Section>

---
import { Image } from "astro:assets";
import Button from "@ui/Button.astro";
import Eyebrow from "@ui/Eyebrow.astro";
import { ctas } from "@config/site";
import { NAV_HEIGHT } from "@config/nav";
import { useTranslations } from "@lib/i18n";
import { media } from "@lib/images";

const t = useTranslations(Astro.currentLocale);
const { headline, headlineClamp, lede } = t.hero;
---

<section
  id="home"
  class="hero relative isolate flex min-h-[100dvh] flex-col overflow-hidden border-b border-line bg-bg"
>
  <div class="hero-shape hero-shape--a pointer-events-none absolute -z-10" aria-hidden="true"></div>
  <div class="hero-shape hero-shape--b pointer-events-none absolute -z-10" aria-hidden="true"></div>

  <div class="hero-scrim pointer-events-none absolute inset-x-0 bottom-0 z-[5] h-[62%] sm:h-[46%] md:h-[38%]" aria-hidden="true"></div>

  <div
    class="relative mx-auto flex w-full max-w-[1400px] flex-1 flex-col px-5 sm:px-8"
    style={`padding-top:${NAV_HEIGHT + 28}px`}
  >
    <div class="hero-copy relative z-10 text-center md:text-left">
      <Eyebrow text={t.roadmap.eyebrow} class="reveal" />
      <h1
        class="hero-headline display reveal mt-2"
        style={`font-size:${headlineClamp}`}
      >
        {
          headline.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.accent ? <span class="text-accent-lift">{line.text}</span> : line.text}
            </>
          ))
        }
      </h1>
    </div>

    <div
      class="hero-figures-layer pointer-events-none absolute inset-x-0 bottom-0 z-0 flex h-[min(64dvh,100dvh-21rem)] min-h-[14rem] items-start justify-center pt-[1dvh] sm:h-[min(68dvh,100dvh-19rem)] sm:pt-[2dvh] md:h-[76dvh] md:pt-[2dvh]"
      aria-hidden="true"
    >
      <div class="hero-figures-stack relative">
        <Image
          src={media.heroGlow.src}
          alt=""
          widths={[480, 768, 1024]}
          sizes="70vw"
          format="webp"
          quality={78}
          loading="eager"
          class="hero-glow pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[110vw] max-w-[58rem] -translate-x-1/2 -translate-y-1/2 sm:w-[82vw] md:w-[66vw]"
        />

        <div
          data-parallax
          class="hero-figures-frame relative w-[104vw] max-w-[60rem] overflow-hidden sm:w-[78vw] md:w-[60vw]"
        >
          <img
            src="/media/hero-figures-poster.webp"
            alt={media.heroFigures.alt}
            width="1376"
            height="768"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            class="hero-figures-fallback absolute inset-0 h-full w-full object-contain"
          />

          <video
            data-hero-video
            class="hero-figures-video relative h-full w-full object-contain"
            muted
            loop
            playsinline
            preload="auto"
            poster="/media/hero-figures-poster.webp"
          >
            <source src="/media/hero-figures-loop.webm" type="video/webm" />
            <source src="/media/hero-figures-loop.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>

    <div class="hero-bottom relative z-10 mt-auto grid gap-8 pb-10 sm:pb-14 lg:grid-cols-12 lg:items-end">
      <p class="lede lg:col-span-6">{lede}</p>

      <div class="flex flex-wrap justify-center gap-3 lg:col-span-5 lg:col-start-8 lg:justify-end">
        <Button {...ctas.community} label={t.cta.community} />
        <Button {...ctas.partnership} label={t.cta.partnership} variant="ghost" />
      </div>
    </div>
  </div>

</section>

<script>

  const hero = document.getElementById("home");
  const frame = hero?.querySelector<HTMLElement>("[data-parallax]");
  const video = hero?.querySelector<HTMLVideoElement>("[data-hero-video]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hasMouse = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (frame && video && !reduced) {
    const revealVideo = () => frame.classList.add("is-video-ready");
    if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) revealVideo();
    else video.addEventListener("canplay", revealVideo, { once: true });

    void video.play().catch(() => {
      frame.classList.remove("is-video-ready");
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) video.pause();
      else void video.play().catch(() => {});
    });
  } else {
    video?.pause();
  }

  if (hero && frame && !reduced && hasMouse) {
    const strength = 14;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let raf = 0;

    const tick = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      frame.style.transform = `translate3d(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px, 0)`;
      if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
      }
    };

    const start = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    hero.addEventListener("pointermove", (e) => {
      const rect = hero.getBoundingClientRect();
      const nx = (e.clientX - rect.left) / rect.width - 0.5;
      const ny = (e.clientY - rect.top) / rect.height - 0.5;
      targetX = nx * strength * 2;
      targetY = ny * strength;
      start();
    });

    hero.addEventListener("pointerleave", () => {
      targetX = 0;
      targetY = 0;
      start();
    });
  }
</script>

<style>

  .hero-shape { background: var(--c-accent); }
  .hero-shape--a {
    top: -12%;
    right: -8%;
    width: 46vw;
    height: 60dvh;
    opacity: 0.07;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .hero-shape--b {
    bottom: -18%;
    left: -10%;
    width: 34vw;
    height: 50dvh;
    opacity: 0.05;
    clip-path: polygon(0 0, 100% 40%, 40% 100%, 0 100%);
  }

  @media (max-width: 639px) {
    .hero-shape { display: none; }

    .hero-figures-layer {
      position: relative;
      inset: auto;
      height: auto;
      min-height: 0;
      flex: none;
      margin-top: 1.5rem;
      padding-top: 0;
    }

    .hero-bottom { margin-top: 1rem; }
  }

  .hero-glow {

    mix-blend-mode: screen;
    filter: brightness(2.4) saturate(1.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow { animation: glow-breathe 6s ease-in-out infinite; }
  }

  @keyframes glow-breathe {

    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.04); }
  }

  .hero-headline {

    line-height: 1.08;
  }

  .hero-scrim {

    background: linear-gradient(to top, var(--c-bg) 42%, transparent 100%);
  }

  .hero-figures-frame {
    aspect-ratio: 43 / 24;
    will-change: transform;

    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, black 2%, black 98%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 10%, black 94%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, black 2%, black 98%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, black 10%, black 94%, transparent 100%);
    mask-composite: intersect;
  }

  @media (min-width: 640px) {
    .hero-figures-frame {
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, black 18%, black 88%, transparent 100%);
      mask-image:
        linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, black 18%, black 88%, transparent 100%);
    }
  }

  .hero-figures-fallback,
  .hero-figures-video {
    transition: opacity 500ms var(--ease-out-quint);
  }

  .hero-figures-video {
    opacity: 0;
  }

  .hero-figures-frame.is-video-ready .hero-figures-fallback { opacity: 0; }
  .hero-figures-frame.is-video-ready .hero-figures-video { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .hero-figures-fallback,
    .hero-figures-video { transition: none; }
  }

</style>

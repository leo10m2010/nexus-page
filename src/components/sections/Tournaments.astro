---
import Section from "@ui/Section.astro";
import StatusBadge from "@ui/StatusBadge.astro";
import { getTournaments, tournamentPath } from "@lib/competition";
import { formatDateRange, formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const tournaments = await getTournaments();
---

<Section id="tournaments" bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">
    {t.competition.tournaments}
  </h2>

  {/* The running tournament takes the wide cell. The grid has exactly as many
      cells as there are tournaments. Each card is one link: the whole card is
      the target, so there is no small "read more" to aim at. */}
  <div class="grid-hairline mt-10 grid md:grid-cols-2">
    {
      tournaments.map((tour, i) => (
        <a
          href={tournamentPath(tour.id, locale)}
          class={`card reveal flex flex-col justify-between gap-8 bg-elev p-8 transition-colors sm:p-10 ${
            i === 0 ? "md:col-span-2" : ""
          }`}
          style={`--reveal-delay:${i * 70}ms`}
        >
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              {tour.series && (
                <p class="eyebrow mb-3 text-muted">{tour.series}</p>
              )}
              <h3
                class={`display-sm ${i === 0 ? "text-[clamp(1.5rem,2.6vw,2.25rem)]" : "text-xl"}`}
              >
                {tour.name}
              </h3>
            </div>
            <StatusBadge status={tour.status} />
          </div>

          <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
            <dl class="flex flex-wrap gap-x-10 gap-y-4 text-[0.9375rem]">
              <div>
                <dt class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">
                  {t.competition.schedule}
                </dt>
                <dd class="mt-1 text-ink">
                  {formatDateRange(tour.startDate, tour.endDate, locale)}
                </dd>
              </div>
              <div>
                <dt class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">
                  {t.competition.teams}
                </dt>
                <dd class="mt-1 text-ink">{t.competition.teamCount(tour.teamCount)}</dd>
              </div>
              <div>
                <dt class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">
                  {tour.region}
                </dt>
                <dd class="mt-1 text-ink">{t.competition.format[tour.format]}</dd>
              </div>
              {tour.prizePool && (
                <div>
                  <dt class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">
                    {t.competition.info.prizePool}
                  </dt>
                  <dd class="mt-1 text-ink">
                    {formatMoney(tour.prizePool.total, tour.prizePool.currency, locale)}
                  </dd>
                </div>
              )}
            </dl>

            <span class="card-cta font-display text-[0.75rem] font-semibold tracking-[0.16em] text-accent-lift uppercase">
              {t.competition.viewTournament}
              <span aria-hidden="true" class="card-arrow">&rarr;</span>
            </span>
          </div>
        </a>
      ))
    }
  </div>
</Section>

<style>
  .card:hover { background: var(--c-bg-elev-2); }
  .card-arrow {
    display: inline-block;
    margin-left: 0.5rem;
    transition: transform 0.3s var(--ease-out-quint);
  }
  .card:hover .card-arrow { transform: translateX(0.25rem); }
  @media (prefers-reduced-motion: reduce) {
    .card-arrow { transition: none; }
  }
</style>

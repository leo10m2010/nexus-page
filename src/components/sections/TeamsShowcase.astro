---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import Eyebrow from "@ui/Eyebrow.astro";
import TeamMark from "@ui/TeamMark.astro";
import { getTeams } from "@lib/competition";
import { localePath, resolveLocale, useTranslations } from "@lib/i18n";
import { showCompetition } from "@config/features";

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const teams = showCompetition ? await getTeams() : [];
const teamsHref = `${localePath(locale)}competition/#teams`.replace("//", "/");
---

{
  teams.length > 0 && (
    <Section id="teams-showcase" bordered>
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
        <div class="max-w-[26ch]">
          <Eyebrow text={t.teamsShowcase.eyebrow} class="reveal" />
          <h2 class="display reveal mt-4 text-[clamp(1.75rem,3.4vw,2.75rem)]" style="--reveal-delay:40ms">
            {t.teamsShowcase.heading}
          </h2>
        </div>
        <a
          href={teamsHref}
          class="showcase-cta reveal font-display text-[0.75rem] font-semibold tracking-[0.16em] text-accent-lift uppercase"
          style="--reveal-delay:90ms"
        >
          {t.teamsShowcase.cta}
          <span aria-hidden="true" class="showcase-arrow">&rarr;</span>
        </a>
      </div>

      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {teams.map((team) => (
          <li class="card-tile min-w-0 flex flex-col gap-4 rounded-card p-6">
            <div class="flex items-center gap-3">
              <TeamMark team={team} size={56} />
              <span class="min-w-0">
                <span class="display-sm block truncate text-base">{team.name}</span>
                <span class="mt-0.5 block text-[0.75rem] text-muted">{team.tag}</span>
              </span>
            </div>

            {
              team.players && (
                <ul class="flex flex-col gap-1.5 border-t border-line pt-4">
                  {team.players.map((player) => (
                    <li class="flex items-center gap-2 text-[0.8125rem] text-ink">
                      {player.country && (
                        <Icon
                          name={`flag:${player.country.toLowerCase()}-4x3`}
                          class="h-3 w-4 shrink-0"
                          aria-label={player.country.toUpperCase()}
                        />
                      )}
                      <span class="truncate">{player.handle}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  .showcase-arrow {
    display: inline-block;
    margin-left: 0.5rem;
    transition: transform 0.3s var(--ease-out-quint);
  }
  .showcase-cta:hover .showcase-arrow { transform: translateX(0.25rem); }
  @media (prefers-reduced-motion: reduce) {
    .showcase-arrow { transition: none; }
  }
</style>

---
import Section from "@ui/Section.astro";
import MediaBackdrop from "@ui/MediaBackdrop.astro";
import NexusMark from "@ui/NexusMark.astro";
import { useTranslations } from "@lib/i18n";
import { media } from "@lib/images";

const t = useTranslations(Astro.currentLocale);
const { heading, lede, pillars } = t.vision;
const id = "vision";
const [lead, ...rest] = pillars;

/* Three pillars, three cells, deliberately unequal weight. The lead cell is
   photographic; the other two carry texture and colour so the grid has real
   background variety rather than three identical text tiles. */
const restStyles = [
  { klass: "chevron-field", style: "" },
  {
    klass: "",
    style:
      "background-image: radial-gradient(80% 90% at 88% 100%, color-mix(in srgb, var(--c-accent) 22%, transparent) 0%, transparent 70%)",
  },
];
---

<Section id={id} bordered>
  <h2 class="display reveal max-w-[20ch] text-[clamp(2rem,4.6vw,3.75rem)]">{heading}</h2>
  <p class="lede reveal mt-7" style="--reveal-delay:80ms">{lede}</p>

  <div class="mt-14 grid gap-px bg-line lg:grid-cols-5 lg:grid-rows-2">
    <article
      class="on-media reveal relative flex min-h-[420px] flex-col justify-end overflow-hidden bg-elev p-8 sm:p-10 lg:col-span-3 lg:row-span-2"
      style="--reveal-delay:60ms"
    >
      <MediaBackdrop
        {...media.broadcastBooth}
        position="62% center"
        scrim="bottom"
        sizes="(min-width: 1024px) 56vw, 92vw"
        tint={16}
      />
      <div class="relative">
        <h3 class="display-sm text-[clamp(1.75rem,3vw,2.75rem)]">{lead!.title}</h3>
        <p class="mt-4 max-w-[38ch] text-[0.9375rem] leading-relaxed text-muted">
          {lead!.body}
        </p>
      </div>
    </article>

    {
      rest.map((p, i) => (
        <article
          class={`reveal relative flex min-h-[212px] flex-col justify-end overflow-hidden bg-elev p-8 sm:p-10 lg:col-span-2 ${restStyles[i]!.klass}`}
          style={`--reveal-delay:${120 + i * 60}ms; ${restStyles[i]!.style}`}
        >
          {i === 1 && (
            <NexusMark class="pointer-events-none absolute -bottom-8 -right-6 h-40 opacity-[0.07]" />
          )}
          <div>
            <h3 class="display-sm text-2xl">{p.title}</h3>
            <p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-relaxed text-muted">
              {p.body}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

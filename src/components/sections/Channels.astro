---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import { channels } from "@config/site";
import { useTranslations } from "@lib/i18n";
import type { ChannelCode } from "@types";

const t = useTranslations(Astro.currentLocale);
---

<Section
  spacing="tight"
  ariaLabel={t.a11y.broadcastChannels}
  class="border-y border-line bg-elev"
  innerClass="flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
>
  <p class="reveal flex items-center gap-3 text-[0.9375rem] text-muted">
    <Icon name="ph:broadcast-bold" class="size-[18px] shrink-0 text-accent-lift" aria-hidden="true" />
    {t.channels.intro}
  </p>

  <ul data-broadcast-channels class="reveal flex flex-wrap items-stretch gap-2" style="--reveal-delay:80ms">
    {
      channels.map((c) => (
        <li class="overflow-hidden rounded-control border border-line-strong bg-elev">
          <a
            class="group flex items-center gap-2.5 px-5 py-3 transition-colors hover:bg-elev2"
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${c.platform} · ${t.channels.languages[c.code.toLowerCase() as ChannelCode]}`}
          >
            <Icon name={`flag:${c.flag}-4x3`} class="h-3.5 w-5 shrink-0" aria-hidden="true" />
            <span class="display-sm text-xl text-ink transition-colors group-hover:text-accent-lift">
              {c.code}
            </span>
            <Icon name={c.icon} class="size-4 shrink-0 text-muted" aria-hidden="true" />
            <span class="text-sm text-muted">{c.platform}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

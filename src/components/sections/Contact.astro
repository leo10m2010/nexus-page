---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import Eyebrow from "@ui/Eyebrow.astro";
import { contactRoutes } from "@config/site";
import { useTranslations } from "@lib/i18n";

const t = useTranslations(Astro.currentLocale);
const { eyebrow, heading, lede } = t.contact;
const id = "contact";
---

<Section id={id} bordered class="relative" innerClass="grid gap-14 lg:grid-cols-12 lg:gap-16">
  <div class="lg:col-span-5">
    <Eyebrow text={eyebrow} class="reveal" />
    <h2 class="display reveal mt-5 text-[clamp(2rem,4.2vw,3.5rem)]">
      {heading.map((l, i) => (<>{i > 0 && <br />}{l}</>))}
    </h2>
    <p class="lede reveal mt-6" style="--reveal-delay:80ms">{lede}</p>
  </div>

  {/* `min-w-0`: this `<ul>` is a grid item (the section's `innerClass` grid
      is active at every width, not just from `lg:`), and a grid item's
      default `min-width: auto` resolves to its content's min-content size.
      That content includes a `truncate` span further down whose text can't
      wrap — without this, the grid item refuses to shrink below that text's
      full width, `truncate` never gets a chance to engage, and the whole
      grid (the whole page, at narrow widths) is forced wider than the
      viewport instead. */}
  <ul class="min-w-0 lg:col-span-7 lg:pt-4">
    {
      contactRoutes.map((r) => (
        <li class="border-t border-line last:border-b">
          <a
            class="route group flex items-center gap-5 py-6"
            href={r.href}
            {...(r.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            <Icon
              name={r.icon}
              class="size-6 shrink-0 text-muted transition-colors group-hover:text-accent-lift"
            />
            <span class="min-w-0 flex-1">
              <span class="block text-[0.75rem] tracking-[0.16em] text-muted uppercase">
                {r.label}
              </span>
              <span class="display-sm mt-1.5 block truncate text-xl transition-colors group-hover:text-accent-lift sm:text-2xl">
                {r.value}
              </span>
            </span>
            <Icon
              name="ph:arrow-up-right-bold"
              class="route-arrow size-5 shrink-0 text-muted transition-all group-hover:text-accent-lift"
            />
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* The arrow leans out on hover: feedback that the row leaves the page. */
  .route-arrow { transition-timing-function: var(--ease-out-quint); }
  .route:hover .route-arrow { transform: translate(3px, -3px); }
  @media (prefers-reduced-motion: reduce) {
    .route:hover .route-arrow { transform: none; }
  }
</style>

---
import { Icon } from "astro-icon/components";
import TeamMark from "@ui/TeamMark.astro";
import UniversalMark from "@ui/UniversalMark.astro";
import { formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";
import type { Team, Tournament } from "@lib/competition";

export interface Stage {
  name: string;
  href: string | null;
  dates: string | null;
  status: Tournament["status"] | null;
  prizeTotal: number;
  currency: string;

  teams: Team[] | null;
  teamCount: number | null;
  icon: string | null;
  accent: string;
  liquipediaUrl: string | null;
}

interface Props {
  stage: Stage;
  numeral: string;
}

const { stage, numeral } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const VISIBLE_TEAMS = 7;
const shownTeams = stage.teams?.slice(0, VISIBLE_TEAMS) ?? [];
const overflow = Math.max(0, (stage.teamCount ?? 0) - shownTeams.length);
---

<article
  class={`stage-card card-tile relative flex w-full flex-col gap-6 overflow-hidden rounded-card p-7 sm:p-8 ${stage.href ? "stage-card--live" : "stage-card--soon"}`}
  style={`--stage-accent:${stage.accent}`}
>

  <UniversalMark
    class="watermark pointer-events-none absolute -right-3 -bottom-4 h-20 w-20"
    style="color:var(--c-brand-lift);opacity:0.07"
    aria-hidden="true"
  />

  {
    stage.href && (
      <a
        href={stage.href}
        class="stage-card-primary-link absolute inset-0 z-[1] rounded-[inherit]"
        aria-label={`${c.viewTournament}: ${stage.name}`}
      />
    )
  }

  <div class="stage-card-header relative flex flex-wrap items-start justify-between gap-4">
    <div class="stage-card-brand flex min-w-0 items-center gap-3">
      {stage.icon ? (
        <img
          src={stage.icon}
          alt=""
          width="27"
          height="40"
          class="numeral season-mark h-10 w-auto shrink-0 object-contain"
        />
      ) : (
        <span
          class="numeral stage-numeral grid h-9 w-9 shrink-0 place-items-center rounded-control border font-display text-base font-bold"
        >
          {numeral}
        </span>
      )}

      {
        stage.liquipediaUrl && (
          <a
            href={stage.liquipediaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="liquipedia-link inline-flex min-h-9 min-w-0 items-center gap-2 rounded-control border border-line-strong px-2.5 py-1.5 font-display text-[0.625rem] font-bold tracking-[0.08em] text-muted uppercase"
            aria-label={`${c.viewOnLiquipedia}: ${stage.name}`}
          >
            <img src="/logos/liquipedia.png" alt="" width="28" height="20" class="h-5 w-auto shrink-0 object-contain" />
            <span class="liquipedia-label">{c.viewOnLiquipedia}</span>
            <Icon name="ph:arrow-up-right-bold" class="size-3.5 shrink-0" aria-hidden="true" />
          </a>
        )
      }
    </div>

    {
      stage.status ? (
        <span class="stage-status inline-flex shrink-0 items-center rounded-control bg-accent px-3 py-1.5 font-display text-[0.6875rem] font-bold tracking-[0.14em] text-on-accent uppercase">
          {c.status[stage.status]}
        </span>
      ) : (
        <span class="stage-status inline-flex shrink-0 items-center gap-2 rounded-control border border-accent/40 px-3 py-1.5 font-display text-[0.6875rem] font-bold tracking-[0.14em] text-accent-lift uppercase">
          <span class="size-1.5 shrink-0 bg-accent-lift/70" aria-hidden="true" />
          {t.roadmap.comingSoon}
        </span>
      )
    }
  </div>

  <h3 class="stage-title relative display-sm text-2xl">{stage.name}</h3>

  {
    shownTeams.length > 0 ? (
      <div class="relative">
        <p class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">{c.teams}</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {shownTeams.map((team) => (
            <TeamMark team={team} size={30} />
          ))}
          {overflow > 0 && (
            <span class="grid h-[30px] min-w-[30px] place-items-center rounded-control border border-line-strong px-1.5 font-display text-[0.6875rem] font-bold text-muted">
              +{overflow}
            </span>
          )}
        </div>
      </div>
    ) : (

      <p class="relative text-[0.9375rem] text-muted">{t.roadmap.detailsTbd}</p>
    )
  }

  <div class="relative mt-auto grid grid-cols-2 gap-4 border-t border-line pt-6">
    <div>
      <p class="stage-date-label text-[0.6875rem] tracking-[0.16em] text-muted uppercase">{c.info.dates}</p>
      <p class="mt-1.5 font-display text-base font-bold text-ink">{stage.dates ?? t.roadmap.dateTbd}</p>
    </div>
    <div class="text-right">
      <p class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">{c.info.prizePool}</p>
      <p class="mt-1.5 font-display text-base font-bold text-accent-lift">
        {stage.prizeTotal > 0 ? formatMoney(stage.prizeTotal, stage.currency, locale) : "—"}
      </p>
    </div>
  </div>

  {
    stage.href && (
      <span class="card-cta relative font-display text-[0.75rem] font-semibold tracking-[0.16em] text-accent-lift uppercase">
        {t.competition.viewTournament}
        <span aria-hidden="true" class="card-arrow">
          &rarr;
        </span>
      </span>
    )
  }
</article>

<style>
  .stage-card {
    isolation: isolate;
    transition: transform 0.35s var(--ease-out-quint), background-color 0.35s var(--ease-out-quint);
  }

  .stage-numeral {
    position: relative;
    border-color: var(--c-line-strong);
    background: var(--c-bg);
    color: color-mix(in srgb, var(--stage-accent) 68%, var(--c-text));
  }

  .stage-numeral::after {
    position: absolute;
    right: 0.45rem;
    bottom: -1px;
    left: 0.45rem;
    height: 1px;
    background: var(--stage-accent);
    content: "";
  }

  .stage-date-label::before {
    display: inline-block;
    width: 0.75rem;
    height: 1px;
    margin-right: 0.4rem;
    background: var(--stage-accent);
    content: "";
    vertical-align: middle;
  }

  .stage-title { text-wrap: balance; }

  .card-arrow {
    display: inline-block;
    margin-left: 0.5rem;
    transition: transform 0.3s var(--ease-out-quint);
  }

  .stage-card-primary-link:focus-visible {
    outline: none;
  }

  .stage-card:has(.stage-card-primary-link:focus-visible) {
    border-color: var(--c-accent);
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }

  .liquipedia-link {
    position: relative;
    z-index: 2;
    background: color-mix(in srgb, var(--c-ink) 5%, transparent);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .liquipedia-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liquipedia-link:hover {
    border-color: var(--c-accent);
    background: color-mix(in srgb, var(--c-accent) 9%, transparent);
    color: var(--c-ink);
  }

  .liquipedia-link:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .stage-card--live:hover { border-color: var(--c-accent); transform: translateY(-6px); }
  .stage-card--live:hover .card-arrow { transform: translateX(0.25rem); }
  .stage-card--live:active { transform: translateY(-2px) scale(0.985); transition-duration: 0.12s; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.watermark) { transition: transform 0.6s var(--ease-out-quint); }
    .stage-card:hover :global(.watermark) { transform: rotate(6deg) scale(1.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-card--live:hover { transform: none; }
    .card-arrow { transition: none; }
  }

  @media (max-width: 560px) {
    .stage-card-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .stage-card-brand {
      display: contents;
    }

    .stage-card-brand > .numeral {
      grid-row: 1;
      grid-column: 1;
    }

    .liquipedia-link {
      grid-row: 2;
      grid-column: 1 / -1;
      max-width: 100%;
      justify-self: start;
    }

    .stage-status {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>

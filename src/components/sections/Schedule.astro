---
import Section from "@ui/Section.astro";
import Scoreline from "@ui/Scoreline.astro";
import { getSchedule } from "@lib/competition";
import { formatDay, formatTime } from "@lib/format";
import { useTranslations } from "@lib/i18n";

const t = useTranslations(Astro.currentLocale);
const days = await getSchedule();
const locale = Astro.currentLocale;
---

<Section id="schedule" bordered>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">
      {t.competition.schedule}
    </h2>
    {days.length > 0 && <p class="reveal text-sm text-muted">{t.competition.timeZoneNote}</p>}
  </div>

  {
    days.length === 0 ? (
      <p class="lede reveal mt-8">{t.competition.empty}</p>
    ) : (

      <div class="mt-10 flex flex-col gap-10">
        {days.map((group) => (
          <div>
            <h3 class="display-sm text-sm text-accent-lift">
              {formatDay(group.date, locale)}
            </h3>
            <ul class="mt-4 flex flex-col gap-3">
              {group.matches.map((match) => (
                <li class="card-tile rounded-card px-5 py-5 sm:px-7">
                  <p class="mb-3 text-[0.6875rem] tracking-[0.16em] text-muted uppercase">
                    {match.tournament.name} <span class="px-1">/</span>{" "}
                    {t.competition.stage[match.stage]}
                  </p>
                  <Scoreline match={match} trailing={formatTime(match.startsAt, locale)} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</Section>

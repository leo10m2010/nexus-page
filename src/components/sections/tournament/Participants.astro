---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import TeamMark from "@ui/TeamMark.astro";
import type { Participant } from "@lib/competition";
import { useTranslations, resolveLocale } from "@lib/i18n";

interface Props {
  id: string;
  participants: Participant[];
}
const { id, participants } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;
---

<Section id={id} bordered>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">{c.section.participants}</h2>
    <p class="reveal text-sm text-muted">{c.teamCount(participants.length)}</p>
  </div>

  <ul class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      participants.map((entry) => (
        <li class="card-tile min-w-0 flex flex-col rounded-card p-6">
          <div class="flex items-start gap-4">
            <TeamMark team={entry.team} size={56} />
            <div class="min-w-0 flex-1">
              <h3 class="display-sm truncate text-base">{entry.team.name}</h3>
              <p class="mt-1 text-[0.8125rem] text-muted">
                {entry.team.tag}
              </p>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            {entry.via && (
              <span class="rounded-control border border-line-strong px-2 py-1 font-display text-[0.625rem] font-bold tracking-[0.14em] text-muted uppercase">
                {c.qualification[entry.via]}
              </span>
            )}
          </div>

          {entry.team.players && (
            <div class="mt-5 border-t border-line pt-4">
              <h4 class="text-[0.625rem] tracking-[0.16em] text-muted uppercase">{c.roster}</h4>
              <ul class="mt-3 flex flex-col gap-2">
                {entry.team.players.map((player) => (
                  <li class="flex items-center gap-2 text-[0.875rem]">
                    {player.country && (
                      <Icon
                        name={`flag:${player.country.toLowerCase()}-4x3`}
                        class="h-3 w-4 shrink-0"
                        aria-label={player.country.toUpperCase()}
                      />
                    )}
                    <span class="truncate text-ink">{player.handle}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {entry.team.liquipediaUrl && (
            <div class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-4 text-[0.6875rem] font-medium text-muted">
              <a
                href={entry.team.liquipediaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent-lift"
              >
                {c.dataFromLiquipedia} · CC BY-SA 3.0
              </a>
              {entry.team.liquipediaLogoSource && (
                <a
                  href={entry.team.liquipediaLogoSource}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent-lift"
                >
                  {c.liquipediaLogoSource}
                </a>
              )}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Section>

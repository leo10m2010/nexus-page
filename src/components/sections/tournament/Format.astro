---
import Section from "@ui/Section.astro";
import type { Phase } from "@lib/competition";
import { useTranslations } from "@lib/i18n";

/* How the tournament is actually played, phase by phase. Every line here is
   built from keys, not from a sentence somebody wrote in one language: the
   YAML says swiss, 16, Bo3, 8, and each locale writes its own sentence. */
interface Props {
  id: string;
  phases: Phase[];
}
const { id, phases } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const c = t.competition;

/* Three phases is the widest this ever gets, and a grid must never have more
   columns than it has cards: an empty cell reads as something missing. */
const columns =
  phases.length >= 3 ? "sm:grid-cols-2 lg:grid-cols-3" : phases.length === 2 ? "sm:grid-cols-2" : "";
---

<Section id={id} bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">{c.section.format}</h2>

  <ol class={`grid-hairline mt-10 grid ${columns}`}>
    {
      phases.map((phase, i) => (
        <li class="reveal bg-elev p-6 sm:p-8" style={`--reveal-delay:${i * 70}ms`}>
          <p class="font-display text-[0.6875rem] font-bold tracking-[0.16em] text-muted tabular-nums">
            {String(i + 1).padStart(2, "0")}
          </p>
          <h3 class="display-sm mt-3 text-xl">{c.phase[phase.key]}</h3>
          <p class="mt-2 text-[0.9375rem] text-accent-lift">{c.format[phase.format]}</p>

          <ul class="mt-5 flex flex-wrap gap-2">
            {phase.teamCount && (
              <li class="border border-line-strong px-2.5 py-1 text-[0.8125rem] text-muted">
                {c.teamCount(phase.teamCount)}
              </li>
            )}
            {phase.bestOf && (
              <li class="border border-line-strong px-2.5 py-1 text-[0.8125rem] text-muted">
                {c.bestOf(phase.bestOf)}
              </li>
            )}
            {phase.advance && (
              <li class="border border-line-strong px-2.5 py-1 text-[0.8125rem] text-muted">
                {c.advance(phase.advance)}
              </li>
            )}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>

---
import { Icon } from "astro-icon/components";
import PageHero from "@ui/PageHero.astro";
import StatusBadge from "@ui/StatusBadge.astro";
import {
  getPrizeTotal,
  getTournamentFormats,
  getTournamentTeamCount,
  type Tournament,
} from "@lib/competition";
import { formatDateRange, formatMoney } from "@lib/format";
import { useTranslations, resolveLocale, DEFAULT_LOCALE } from "@lib/i18n";

interface Props {
  tournament: Tournament;
}
const { tournament } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const backHref = `${locale === DEFAULT_LOCALE ? "" : `/${locale}`}/competition/`;
const prizeTotal = getPrizeTotal(tournament);
const teamCount = getTournamentTeamCount(tournament);
const formatSummary = getTournamentFormats(tournament).map((format) => c.format[format]).join(" + ");

const where = tournament.location
  ? { label: c.info.location, value: tournament.location, icon: "ph:map-pin-bold" }
  : tournament.venue
    ? { label: c.info.venue, value: c.venue[tournament.venue], icon: "ph:map-pin-bold" }
    : { label: c.info.location, value: tournament.region || null, icon: "ph:map-pin-bold" };

const facts = [
  {
    label: c.info.dates,
    value: formatDateRange(tournament.startDate, tournament.endDate, locale),
    icon: "ph:calendar-blank-bold",
  },
  {
    label: c.info.prizePool,
    value: tournament.prizePool && prizeTotal != null
      ? formatMoney(prizeTotal, tournament.prizePool.currency, locale)
      : null,
    icon: "ph:trophy-fill",
    accent: true,
  },
  { label: c.info.teams, value: teamCount == null ? null : c.teamCount(teamCount), icon: "ph:users-three-bold" },
  { label: c.info.format, value: formatSummary || null, icon: "ph:flow-arrow-bold" },
  where,
].filter((f): f is { label: string; value: string; icon: string; accent?: boolean } => f.value !== null);

---

<PageHero title={tournament.name} description={tournament.status === "upcoming" ? t.roadmap.detailsTbd : undefined} art>
  <div slot="before">
    <a
      href={backHref}
      class="eyebrow reveal inline-flex items-center gap-2 text-muted transition-colors hover:text-accent-lift"
    >
      <span aria-hidden="true">&larr;</span>
      {c.allTournaments}
    </a>

    <div class="reveal mt-6 flex flex-wrap items-center gap-4">
      <StatusBadge status={tournament.status} />
    </div>

  </div>
    <dl class="flex flex-wrap gap-x-10 gap-y-6 border-t border-line pt-8">
      {
        facts.map((fact) => (
          <div>
              <dt class="flex items-center gap-2 text-[0.6875rem] tracking-[0.16em] text-muted uppercase"><Icon name={fact.icon} class={`size-4 shrink-0 ${fact.accent ? "text-accent-lift" : "text-muted"}`} />{fact.label}</dt>
              <dd class={`display-sm mt-0.5 text-[1.0625rem] ${fact.accent ? "text-accent-lift" : ""}`}>
                {fact.value}
              </dd>
          </div>
        ))
      }
    </dl>
</PageHero>

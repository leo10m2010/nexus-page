---
import Section from "@ui/Section.astro";
import StatusBadge from "@ui/StatusBadge.astro";
import type { Tournament } from "@lib/competition";
import { formatDateRange, formatMoney } from "@lib/format";
import { useTranslations, resolveLocale, DEFAULT_LOCALE } from "@lib/i18n";
import { NAV_HEIGHT } from "@config/nav";

interface Props {
  tournament: Tournament;
}
const { tournament } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const backHref = `${locale === DEFAULT_LOCALE ? "" : `/${locale}`}/competition/`;

const where = tournament.location
  ? { label: c.info.location, value: tournament.location }
  : tournament.venue
    ? { label: c.info.venue, value: c.venue[tournament.venue] }
    : { label: c.info.location, value: tournament.region };

const facts = [
  { label: c.info.dates, value: formatDateRange(tournament.startDate, tournament.endDate, locale) },
  {
    label: c.info.prizePool,
    value: tournament.prizePool
      ? formatMoney(tournament.prizePool.total, tournament.prizePool.currency, locale)
      : null,
  },
  { label: c.info.teams, value: c.teamCount(tournament.teamCount) },
  { label: c.info.format, value: c.format[tournament.format] },
  where,
].filter((f): f is { label: string; value: string } => f.value !== null);

const series =
  tournament.series && !tournament.name.toLowerCase().includes(tournament.series.toLowerCase())
    ? tournament.series
    : null;

const columns =
  { 4: "lg:grid-cols-4", 5: "lg:grid-cols-5" }[facts.length] ?? "lg:grid-cols-5";
---

<Section class="relative overflow-hidden border-b border-line">

  <div class="chevron-field pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="relative" style={`padding-top:${NAV_HEIGHT}px`}>
    <a
      href={backHref}
      class="eyebrow reveal inline-flex items-center gap-2 text-muted transition-colors hover:text-accent-lift"
    >
      <span aria-hidden="true">&larr;</span>
      {c.allTournaments}
    </a>

    <div class="reveal mt-6 flex flex-wrap items-center gap-4">
      {series && <p class="eyebrow">{series}</p>}
      <StatusBadge status={tournament.status} />
    </div>

    <h1 class="display reveal mt-5 max-w-[24ch] text-[clamp(2rem,5vw,4.25rem)]">
      {tournament.name}
    </h1>

    <dl class={`reveal mt-12 grid gap-px border-t border-line bg-line sm:grid-cols-2 ${columns}`}>
      {
        facts.map((fact) => (
          <div class="bg-bg pt-5 sm:pr-6">
            <dt class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">{fact.label}</dt>
            <dd class="display-sm mt-2 text-[1.0625rem]">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import StatusBadge from "@ui/StatusBadge.astro";
import type { Tournament } from "@lib/competition";
import { formatDateRange, formatMoney } from "@lib/format";
import { useTranslations, resolveLocale, DEFAULT_LOCALE } from "@lib/i18n";
import { NAV_HEIGHT } from "@config/nav";

interface Props {
  tournament: Tournament;
}
const { tournament } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const backHref = `${locale === DEFAULT_LOCALE ? "" : `/${locale}`}/competition/`;

const where = tournament.location
  ? { label: c.info.location, value: tournament.location, icon: "ph:map-pin-bold" }
  : tournament.venue
    ? { label: c.info.venue, value: c.venue[tournament.venue], icon: "ph:map-pin-bold" }
    : { label: c.info.location, value: tournament.region, icon: "ph:map-pin-bold" };

const facts = [
  {
    label: c.info.dates,
    value: formatDateRange(tournament.startDate, tournament.endDate, locale),
    icon: "ph:calendar-blank-bold",
  },
  {
    label: c.info.prizePool,
    value: tournament.prizePool
      ? formatMoney(tournament.prizePool.total, tournament.prizePool.currency, locale)
      : null,
    icon: "ph:trophy-fill",
    accent: true,
  },
  { label: c.info.teams, value: c.teamCount(tournament.teamCount), icon: "ph:users-three-bold" },
  { label: c.info.format, value: c.format[tournament.format], icon: "ph:flow-arrow-bold" },
  where,
].filter((f): f is { label: string; value: string; icon: string; accent?: boolean } => f.value !== null);

const series =
  tournament.series && !tournament.name.toLowerCase().includes(tournament.series.toLowerCase())
    ? tournament.series
    : null;
---

<Section class="relative overflow-hidden border-b border-line">

  <div class="chevron-field pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="relative" style={`padding-top:${NAV_HEIGHT}px`}>
    <a
      href={backHref}
      class="eyebrow reveal inline-flex items-center gap-2 text-muted transition-colors hover:text-accent-lift"
    >
      <span aria-hidden="true">&larr;</span>
      {c.allTournaments}
    </a>

    <div class="reveal mt-6 flex flex-wrap items-center gap-4">
      {series && <p class="eyebrow">{series}</p>}
      <StatusBadge status={tournament.status} />
    </div>

    <h1 class="display reveal mt-5 max-w-[24ch] text-[clamp(2rem,5vw,4.25rem)]">
      {tournament.name}
    </h1>

    <dl class="reveal mt-12 flex flex-wrap gap-x-10 gap-y-6 border-t border-line pt-8">
      {
        facts.map((fact) => (
          <div class="flex items-center gap-3">
            <Icon
              name={fact.icon}
              class={`size-5 shrink-0 ${fact.accent ? "text-accent-lift" : "text-muted"}`}
            />
            <div>
              <dt class="text-[0.6875rem] tracking-[0.16em] text-muted uppercase">{fact.label}</dt>
              <dd class={`display-sm mt-0.5 text-[1.0625rem] ${fact.accent ? "text-accent-lift" : ""}`}>
                {fact.value}
              </dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

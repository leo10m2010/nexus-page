---
import { Icon } from "astro-icon/components";
import { getPrizeTotal, type Tournament, type Phase } from "@lib/competition";
import { formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";
interface Props { tournament: Tournament; phases: Phase[]; }
const { tournament, phases } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const c = useTranslations(locale).competition;
const prize = tournament.prizePool;
const payouts = prize?.distribution ?? [];
const distributionPending = { es: "El reparto por puestos se anunciará próximamente.", en: "The prize distribution will be announced soon.", ru: "Распределение призовых будет объявлено позже." }[locale];
const placement = (row: (typeof payouts)[number]) => row.to ? c.placeRange(row.place, row.to) : c.place(row.place);
---
<div class="tournament-overview">
  {prize && <section id="prizes" class="prize-section" aria-labelledby="prize-title">
    <header class="overview-heading"><h2 id="prize-title"><Icon name="ph:trophy" aria-hidden="true" />{c.info.prizePool}</h2><p>{formatMoney(getPrizeTotal(tournament) ?? 0, prize.currency, locale)}</p></header>
    {payouts.length ? <ol class="prize-podium">
      {payouts.map(row => <li class:list={["prize-card", { "is-primary": row.place === 1 }]}>
        <span class="prize-place">{placement(row)}<small>{c.prizeHead.place}</small></span>
        <span class="prize-emblem" aria-hidden="true"><Icon name={row.place === 1 ? "ph:crown-simple-fill" : row.place === 2 ? "ph:trophy-fill" : "ph:medal-fill"} /></span>
        <p class="prize-amount">{formatMoney(row.amount, prize.currency, locale)}</p>
      </li>)}
    </ol> : <p class="prize-pending">{distributionPending}</p>}
  </section>}
  {phases.length > 0 && <section id="format" class="format-section" aria-labelledby="format-title">
    <h2 id="format-title">{c.section.format}</h2>
    <ol class="format-flow">{phases.map(phase => <li class="phase-step">
      <span class="phase-emblem" aria-hidden="true"><Icon name={phase.key === "groupStage" ? "ph:users-four" : "ph:tree-structure"} /></span>
      <div><h3>{c.phase[phase.key]}</h3><p>{c.format[phase.format]}</p><ul class="phase-stats">{phase.teamCount && <li><Icon name="ph:users-three" aria-hidden="true" />{c.teamCount(phase.teamCount)}</li>}{phase.bestOf && <li><Icon name="ph:sword" aria-hidden="true" />{c.bestOf(phase.bestOf)}</li>}{phase.advance && phase.advance !== phase.teamCount && <li><Icon name="ph:arrow-right" aria-hidden="true" />{c.advance(phase.advance)}</li>}</ul></div>
    </li>)}</ol>
  </section>}
</div>
<style>
  .tournament-overview { width: min(1180px, calc(100% - 64px)); margin: auto; padding: 45px 0; }
  .tournament-overview section { scroll-margin-top: 52px; }
  .overview-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 15px 25px; border-bottom: 1px solid var(--c-line-strong); padding-bottom: 18px; }
  .overview-heading h2, .format-section h2 { font: 400 clamp(34px, 3vw, 46px)/1 var(--font-poster); text-transform: uppercase; color: var(--c-accent-lift); }
  .overview-heading h2 { display: flex; align-items: center; gap: 13px; }
  .overview-heading h2 svg { width: 28px; height: 28px; color: var(--c-accent-lift); }
  .overview-heading > p { font: 400 clamp(34px, 4vw, 55px)/1 var(--font-poster); color: var(--c-text); }
  .prize-podium { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 22px; margin-top: 28px; }
  .prize-pending { color: var(--c-text-muted); font-size: 14px; line-height: 1.6; margin-top: 24px; }
  .prize-card { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 24px; min-height: 180px; padding: 24px; border: 1px solid var(--c-line-strong); background: var(--c-bg-elev); }
  .prize-card.is-primary { border-top-color: var(--c-accent-lift); background: color-mix(in srgb, var(--c-brand) 14%, var(--c-bg-elev)); }
  .prize-card::before, .prize-card::after { content: ""; position: absolute; width: 12px; height: 12px; pointer-events: none; border-color: var(--c-line-strong); border-style: solid; }
  .prize-card::before { left: -1px; top: -1px; border-width: 1px 0 0 1px; }
  .prize-card::after { bottom: -1px; right: -1px; border-width: 0 1px 1px 0; }
  .prize-card.is-primary::before, .prize-card.is-primary::after { border-color: var(--c-accent-lift); width: 24px; height: 24px; }
  .prize-place { font: 400 36px/1 var(--font-poster); }
  .prize-place small { display: block; font-size: 10px; font-weight: 400; color: var(--c-text-muted); margin-top: 4px; }
  .prize-emblem { display: grid; place-items: center; width: 56px; height: 56px; color: var(--c-text-muted); }
  .prize-emblem svg { width: 45px; height: 45px; }
  .is-primary .prize-emblem { color: var(--c-accent-lift); }
  .prize-amount { grid-column: 1 / -1; align-self: end; font: 400 clamp(30px, 3vw, 43px)/1 var(--font-poster); }
  .is-primary .prize-amount { color: var(--c-accent-lift); }
  .format-section { margin-top: 40px; }
  .format-flow { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 45px; margin-top: 25px; }
  .phase-step { position: relative; display: flex; gap: 20px; border-top: 1px solid var(--c-line-strong); padding-top: 24px; }
  .phase-step > div { min-width: 0; }
  .phase-emblem { display: grid; place-items: center; width: 54px; height: 54px; flex-shrink: 0; background: var(--c-bg-elev); border: 1px solid var(--c-line); color: var(--c-accent-lift); }
  .phase-emblem svg { width: 30px; height: 30px; }
  .phase-step h3 { font: 400 28px/1.1 var(--font-poster); text-transform: uppercase; }
  .phase-step p { margin-top: 8px; font-size: 13px; color: var(--c-text-muted); }
  .phase-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 13px; font-size: 11px; }
  .phase-stats li + li { padding-left: 10px; border-left: 1px solid var(--c-line-strong); }
  .phase-stats li { display: flex; align-items: center; gap: 6px; }
  .phase-stats svg { width: 14px; height: 14px; color: var(--c-accent-lift); }
  @media (max-width: 767px) { .tournament-overview { width: calc(100% - 40px); padding-block: 35px; } .prize-podium { grid-template-columns: 1fr; gap: 12px; margin-top: 20px; } .prize-card { min-height: 0; grid-template-columns: auto 1fr auto; align-items: center; padding: 18px; gap: 15px; } .prize-emblem { grid-column: 1; grid-row: 1; width: 38px; height: 38px; } .prize-emblem svg { width: 31px; height: 31px; } .prize-place { grid-column: 2; grid-row: 1; font-size: 18px; } .prize-amount { grid-column: 3; grid-row: 1; align-self: center; font-size: 24px; } .format-flow { grid-template-columns: 1fr; gap: 24px; } }
</style>

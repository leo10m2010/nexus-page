---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import TeamMark from "@ui/TeamMark.astro";
import BracketMatch from "./BracketMatch.astro";
import type { BracketSide, ResolvedMatch } from "@lib/competition";
import { formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";
import backdrop from "@assets/hero-background.png";
interface Props { id: string; sides: BracketSide[]; }
const { id, sides } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const c = useTranslations(locale).competition;
const copy = {
  es: { title: "Playoffs", champion: "Campeón", pending: "El título espera", hint: "Explora los cruces", previous: "Ver cruces anteriores", next: "Ver siguientes cruces", winners: "Avance", losers: "Segunda oportunidad" },
  en: { title: "Playoffs", champion: "Champion", pending: "The title awaits", hint: "Explore the bracket", previous: "Show earlier rounds", next: "Show later rounds", winners: "Advancement", losers: "Second chance" },
  ru: { title: "Плей-офф", champion: "Чемпион", pending: "Титул ждёт", hint: "Смотрите сетку", previous: "Предыдущие раунды", next: "Следующие раунды", winners: "Проход дальше", losers: "Второй шанс" },
}[locale];
const allMatches = sides.flatMap(side => side.rounds.flatMap(round => round.matches));
const placements = allMatches.filter(match => match.stage === "thirdPlace");
const roundsOf = (name: BracketSide["side"]) => (sides.find(side => side.side === name)?.rounds ?? []).map(round => ({...round, matches: round.matches.filter(match => match.stage !== "thirdPlace")})).filter(round => round.matches.length);
const upper = roundsOf("upper");
const lower = roundsOf("lower");
const finals = roundsOf("final");
const laneRounds = Math.max(upper.length, lower.length, 1);
const finalMatch = finals.at(-1)?.matches.at(-1) ?? null;
const winningTeam = (match: ResolvedMatch | null) => {
  if (!match) return null;
  if (match.walkover) return match[match.walkover];
  const needed = Math.floor((match.bestOf ?? 3) / 2) + 1;
  if (!match.score || Math.max(match.score.home, match.score.away) !== needed || Math.min(match.score.home, match.score.away) >= needed) return null;
  return match.score.home > match.score.away ? match.home : match.away;
};
const champion = winningTeam(finalMatch);
const prizePool = finalMatch?.tournament.prizePool;
const firstPrize = prizePool?.distribution?.find(row => row.place === 1);
// All links follow the published homeSource/awaySource, including lower-bracket drops.
const CARD = 238, GAP = 56, MATCH = 123, PAD = 24, TOP = 80;
const laneHeight = (rounds: typeof upper) => Math.max(...rounds.map(round => round.matches.length), 1) * (MATCH + 50) - 50;
const upperHeight = laneHeight(upper);
const lowerTop = TOP + upperHeight + 110;
const lowerHeight = laneHeight(lower);
const finalTop = lower.length ? (TOP + upperHeight / 2 + lowerTop + lowerHeight / 2) / 2 - MATCH / 2 : TOP + upperHeight / 2 - MATCH / 2;
type Node = { match: ResolvedMatch; x: number; y: number; side: BracketSide["side"]; };
const nodes: Node[] = [];
const labels: { text: string; x: number; y: number; }[] = [];
for (const [name, rounds, start, height] of [["upper", upper, TOP, upperHeight], ["lower", lower, lowerTop, lowerHeight]] as const) {
  rounds.forEach((round, index) => {
    const column = name === "lower" ? laneRounds - rounds.length + index : index;
    const x = PAD + column * (CARD + GAP);
    labels.push({text: `${index === 0 ? `${c.bracketSide[name]} · ` : ""}${round.stage ? c.stage[round.stage] : c.round(round.round)}`, x, y: start - 30});
    round.matches.forEach((match, i) => nodes.push({match, side: name, x, y: start + (i + .5) * height / round.matches.length - MATCH / 2}));
  });
}
finals.forEach((round, index) => {
  const x = PAD + (laneRounds + index) * (CARD + GAP);
  labels.push({text: round.stage ? c.stage[round.stage] : c.bracketSide.final, x, y: finalTop - 30});
  round.matches.forEach((match, i) => nodes.push({match, side: "final", x, y: finalTop + i * (MATCH + 50)}));
});
const championX = PAD + (laneRounds + finals.length) * (CARD + GAP);
const boardWidth = championX + (finalMatch ? 222 : 0) + PAD;
const boardHeight = Math.max(lower.length ? lowerTop + lowerHeight : TOP + upperHeight, finalTop + finals.reduce((max, round) => Math.max(max, round.matches.length), 1) * (MATCH + 50)) + 50;
const links = nodes.flatMap(target => (["home", "away"] as const).flatMap((seat, seatIndex) => {
  const source = target.match[`${seat}Source`];
  const origin = source ? nodes.find(node => node.match.id === source.match) : null;
  if (!origin || !source) return [];
  const sy = origin.y + 74;
  const ty = target.y + 26 + seatIndex * 48 + 24;
  const forward = target.x > origin.x;
  const sx = forward ? origin.x + CARD : origin.x;
  const bend = forward ? (sx + target.x) / 2 : origin.x - (seatIndex ? 18 : 12);
  return [{source: source.match, target: target.match.id, seat, outcome: source.outcome, d: `M ${sx} ${sy} H ${bend} V ${ty} H ${target.x}`}];
}));
const finalNode = nodes.find(node => node.match.id === finalMatch?.id);
---

<section id={id} class="playoffs-section" aria-labelledby={`${id}-title`}>
  <div class="playoffs-wrap">
    <header class="playoffs-heading"><span>{allMatches[0]?.tournament.name}</span><h2 id={`${id}-title`}>{copy.title}</h2><Icon name="ph:crosshair-simple" aria-hidden="true" /></header>
    <div class="playoffs-toolbar"><div class="path-key"><span>{copy.winners}</span>{lower.length > 0 && <span class="loss-key">{copy.losers}</span>}</div><div class="bracket-controls"><span>{copy.hint}</span><button type="button" data-bracket-scroll="-1" aria-label={copy.previous}><Icon name="ph:arrow-left" /></button><button type="button" data-bracket-scroll="1" aria-label={copy.next}><Icon name="ph:arrow-right" /></button></div></div>
    <div class="bracket-viewport" role="region" aria-label={`${copy.title}: ${c.section.bracket}`} tabindex="0">
      <div class="bracket-board" style={`width:${boardWidth}px;height:${boardHeight}px;--match-width:${CARD}px`}>
        <Image class="bracket-backdrop" src={backdrop} alt="" widths={[900,1400]} sizes="1400px" format="webp" loading="lazy" />
        <svg class="bracket-paths" width={boardWidth} height={boardHeight} viewBox={`0 0 ${boardWidth} ${boardHeight}`} aria-hidden="true">
          {links.map(link => <path d={link.d} class:list={["advancement-path", { "drop-path": link.outcome === "loser" }]} data-source={link.source} data-target={link.target} data-target-seat={link.seat} />)}
          {finalNode && <path class="champion-path" d={`M ${finalNode.x + CARD} ${finalNode.y + 74} H ${championX}`} />}
        </svg>
        {labels.map(label => <h3 class="round-label" style={`left:${label.x}px;top:${label.y}px`}>{label.text}</h3>)}
        {nodes.map(node => <div class="bracket-node" data-side={node.side} style={`left:${node.x}px;top:${node.y}px`}><BracketMatch match={node.match} final={node.side === "final"} /></div>)}
        {finalNode && <aside class="champion-display" style={`left:${championX}px;top:${finalNode.y - 67}px`} data-champion={champion?.id ?? "pending"} aria-label={`${copy.champion}: ${champion?.name ?? c.tbd}`}>
          <p class="champion-label">{champion ? copy.champion : copy.pending}</p>
          <div class="champion-medallion">{champion ? <TeamMark team={champion} size={86} /> : <Icon name="ph:trophy" aria-hidden="true" />}</div>
          <h3>{champion?.name ?? c.tbd}</h3>{champion && <p class="champion-tag">#{champion.tag}</p>}
          {firstPrize && prizePool && <p class="champion-prize">{formatMoney(firstPrize.amount, prizePool.currency, locale)}</p>}
        </aside>}
      </div>
    </div>
    <div class="playoffs-bottom"><p>{c.timeZoneNote}</p>{placements.length > 0 && <div class="placement-matches"><h3>{c.stage.thirdPlace}</h3>{placements.map(match => <BracketMatch match={match} />)}</div>}</div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.playoffs-section').forEach(section => {
    const viewport = section.querySelector<HTMLElement>('.bracket-viewport');
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-bracket-scroll]')];
    if (!viewport) return;
    const update = () => {
      section.dataset.overflow = String(viewport.scrollWidth > viewport.clientWidth + 1);
      for (const button of buttons) button.disabled = Number(button.dataset.bracketScroll) < 0 ? viewport.scrollLeft <= 1 : viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 1;
    };
    buttons.forEach(button => button.addEventListener('click', () => viewport.scrollBy({left: Number(button.dataset.bracketScroll) * Math.min(viewport.clientWidth * .8, 588), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'})));
    viewport.addEventListener('scroll', update, {passive:true});
    new ResizeObserver(update).observe(viewport);
    update();
  });
</script>

<style>
  .playoffs-section { padding: 70px 0 55px; border-block: 1px solid var(--c-line); background: var(--c-bg); scroll-margin-top: 52px; }
  .playoffs-wrap { width: min(1320px, calc(100% - 64px)); margin: auto; }
  .playoffs-heading { position: relative; text-align: center; padding: 24px 60px; border-block: 1px solid var(--c-line-strong); background: linear-gradient(115deg, transparent 25%, color-mix(in srgb, var(--c-brand) 12%, transparent), transparent 75%); }
  .playoffs-heading > span { display: block; color: var(--c-text-muted); text-transform: uppercase; font-size: 10px; letter-spacing: .16em; }
  .playoffs-heading h2 { font: 400 clamp(40px, 4vw, 56px)/1 var(--font-poster); text-transform: uppercase; color: var(--c-accent-lift); margin-top: 6px; }
  .playoffs-heading > svg { position: absolute; width: 29px; height: 29px; right: 16px; top: calc(50% - 14px); color: var(--c-text-muted); }
  .playoffs-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 0 10px; }
  .path-key, .bracket-controls { display: flex; align-items: center; gap: 18px; font-size: 10px; color: var(--c-text-muted); }
  .path-key span { display: inline-flex; align-items: center; gap: 8px; }
  .path-key span::before { content: ""; width: 20px; height: 0; border-top: 1px solid var(--c-accent-lift); }
  .path-key .loss-key::before { border-top-style: dashed; border-top-color: var(--c-text-muted); }
  .bracket-controls { gap: 6px; }
  .playoffs-section[data-overflow="false"] .bracket-controls { visibility: hidden; }
  .bracket-controls > span { margin-right: 10px; }
  .bracket-controls button { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--c-line-strong); color: var(--c-accent-lift); }
  .bracket-controls button:disabled { opacity: .3; cursor: default; }
  .bracket-controls svg { width: 16px; height: 16px; }
  .bracket-viewport { width: 100%; overflow-x: auto; scrollbar-width: thin; scrollbar-color: var(--c-line-strong) transparent; overscroll-behavior-x: contain; }
  .bracket-board { position: relative; isolation: isolate; margin-inline: auto; }
  .bracket-backdrop { position: absolute; z-index: -2; width: 100%; height: 100%; object-fit: cover; opacity: .1; mask-image: linear-gradient(0deg, transparent, #000 20%, #000 80%, transparent); }
  .bracket-paths { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .bracket-paths path { fill: none; stroke: var(--c-accent-lift); stroke-width: 1; opacity: .55; }
  .bracket-paths .drop-path { stroke: var(--c-text-muted); opacity: .4; stroke-dasharray: 4 5; }
  .bracket-paths .champion-path { opacity: .85; }
  .round-label { position: absolute; width: var(--match-width); color: var(--c-text-muted); font: 400 17px/1 var(--font-poster); text-transform: uppercase; letter-spacing: .025em; }
  .bracket-node { position: absolute; width: var(--match-width); }
  .champion-display { position: absolute; width: 222px; text-align: center; padding: 8px 10px; }
  .champion-label { color: var(--c-accent-lift); font: 400 29px/1 var(--font-poster); text-transform: uppercase; }
  .champion-medallion { position: relative; display: grid; place-items: center; width: 158px; height: 158px; margin: 25px auto 20px; border: 1px solid color-mix(in srgb, var(--c-accent-lift) 55%, transparent); border-radius: 50%; }
  .champion-medallion::before { content: ""; position: absolute; inset: -10px; border: 1px solid var(--c-line-strong); border-top-color: var(--c-accent-lift); border-bottom-color: var(--c-accent-lift); border-radius: 50%; transform: rotate(-28deg); }
  .champion-medallion::after { content: ""; position: absolute; inset: 9px; border: 1px dashed var(--c-line-strong); border-radius: 50%; }
  .champion-medallion > svg { width: 54px; height: 54px; color: var(--c-accent-lift); opacity: .7; }
  .champion-display h3 { font: 400 24px/1.1 var(--font-poster); text-transform: uppercase; }
  .champion-tag { color: var(--c-text-muted); font-size: 10px; margin-top: 5px; }
  .champion-prize { margin-top: 12px; font-size: 12px; color: var(--c-accent-lift); }
  .playoffs-bottom { display: flex; justify-content: space-between; align-items: start; gap: 35px; border-top: 1px solid var(--c-line); padding-top: 22px; }
  .playoffs-bottom > p { color: var(--c-text-muted); font-size: 11px; line-height: 1.6; max-width: 400px; }
  .placement-matches { width: 238px; flex-shrink: 0; }
  .placement-matches > h3 { font: 400 19px/1 var(--font-poster); text-transform: uppercase; color: var(--c-text-muted); margin-bottom: 9px; }
  @media (max-width: 767px) { .playoffs-wrap { width: calc(100% - 32px); } .playoffs-section { padding-top: 45px; } .playoffs-toolbar { flex-wrap: wrap; gap: 10px; } .path-key { gap: 12px; } .bracket-controls { margin-left: auto; } .bracket-controls > span { display: none; } .playoffs-bottom { flex-direction: column; gap: 25px; } .placement-matches { width: min(100%, 300px); } }
</style>

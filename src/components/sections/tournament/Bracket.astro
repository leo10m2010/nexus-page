---
import { Icon } from "astro-icon/components";
import TeamMark from "@ui/TeamMark.astro";
import Section from "@ui/Section.astro";
import type { BracketRound, BracketSide, ResolvedMatch } from "@lib/competition";
import { formatDate, formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";

interface Props {
  id: string;
  sides: BracketSide[];
}
const { id, sides } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const pairs = (matches: ResolvedMatch[]): ResolvedMatch[][] =>
  matches.reduce<ResolvedMatch[][]>((out, match, i) => {
    if (i % 2 === 0) out.push([match]);
    else out[out.length - 1]!.push(match);
    return out;
  }, []);

const feeds = (round: BracketRound, next: BracketRound | undefined): boolean =>
  next != null &&
  (next.matches.length * 2 === round.matches.length ||
    (next.matches.length === 1 && round.matches.length === 1));

const heading = (round: BracketRound): string =>
  round.stage ? c.stage[round.stage] : c.round(round.round);

const repeatsSide = (side: BracketSide, round: BracketRound): boolean =>
  sides.length > 1 && side.rounds.length === 1 && heading(round) === c.bracketSide[side.side];

const winner = (match: ResolvedMatch, side: "home" | "away"): boolean => {
  if (!match.score) return false;
  const { home, away } = match.score;
  if (match.bestOf) {
    const winsNeeded = Math.floor(match.bestOf / 2) + 1;
    if (Math.max(home, away) !== winsNeeded || Math.min(home, away) >= winsNeeded) return false;
  }
  return side === "home" ? home > away : away > home;
};

const winningTeam = (match: ResolvedMatch) => {
  if (winner(match, "home")) return match.home;
  if (winner(match, "away")) return match.away;
  return null;
};

const finalSide = sides.find((side) => side.side === "final");
const finalRound = finalSide?.rounds[finalSide.rounds.length - 1];
const finalMatch = finalRound?.matches[finalRound.matches.length - 1] ?? null;
const champion = finalMatch ? winningTeam(finalMatch) : null;
const prizePool = finalMatch?.tournament.prizePool;
const winnerPayout = prizePool?.distribution.find((row) => row.place === 1);
const championPrize = winnerPayout && prizePool
  ? formatMoney(winnerPayout.amount, prizePool.currency, locale)
  : null;
---

<Section id={id} bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">{c.section.bracket}</h2>

  <div class="bracket-shell reveal mt-10">
    <div
      class="bracket-viewport"
      role="region"
      aria-label={c.section.bracket}
      tabindex="0"
    >
      <div class="bracket-board">
        {
          sides.map((side) => (
            <section
              class={`bracket-track track-${side.side}`}
              data-side={side.side}
              aria-labelledby={`${id}-${side.side}`}
            >
              <h3 id={`${id}-${side.side}`} class="bracket-side-label display-sm">
                <span aria-hidden="true"></span>
                {c.bracketSide[side.side]}
              </h3>

              <div class="bracket">
                {side.rounds.map((round, r) => (
                  <div class={`bracket-round ${feeds(round, side.rounds[r + 1]) ? "is-feeding" : ""}`}>
                    {!repeatsSide(side, round) && <h4 class="bracket-head">{heading(round)}</h4>}

                    <div class="bracket-body">
                      {pairs(round.matches).map((pair) => (
                        <div class={`bracket-pair ${pair.length === 2 ? "is-pair" : ""}`}>
                          {pair.map((match) => (
                            <article class="bracket-match">
                              <p class="bracket-meta">
                                <span>{formatDate(match.startsAt, locale)}</span>
                                {match.bestOf && <span>{c.bestOf(match.bestOf)}</span>}
                              </p>

                              {(["home", "away"] as const).map((seat) => (
                                <div class={`bracket-seat ${winner(match, seat) ? "is-winner" : ""}`}>
                                  <TeamMark team={match[seat]} size={20} />

                                  <span class="truncate">{match[seat]?.name ?? c.tbd}</span>
                                  <span class="bracket-score tabular-nums">
                                    {match.score ? match.score[seat] : "-"}
                                  </span>
                                  {winner(match, seat) && <span class="sr-only">, {c.winner}</span>}
                                </div>
                              ))}
                            </article>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))
        }

        {finalMatch && (
          <>
            <span class="merge-connector" aria-hidden="true">
              <span class="merge-leg is-upper"></span>
              <span class="merge-leg is-lower"></span>
              <span class="merge-leg is-output"></span>
            </span>

            <span class="champion-connector" aria-hidden="true"></span>
            <aside
              class={`champion-card${champion ? " is-crowned" : ""}`}
              data-spotlight
              aria-label={`${c.winner}: ${champion?.name ?? c.tbd}`}
            >
              <p class="champion-label">{c.winner}</p>

              <div class="champion-mark" aria-hidden={!champion ? "true" : undefined}>
                {champion ? (
                  <TeamMark team={champion} size={72} />
                ) : (
                  <Icon name="ph:crown-simple-fill" />
                )}
              </div>

              <h4 class="champion-name display-sm">{champion?.name ?? c.tbd}</h4>

              {championPrize && (
                <p class="champion-prize tabular-nums">
                  <Icon name="ph:trophy-fill" aria-hidden="true" />
                  {championPrize}
                </p>
              )}
            </aside>
          </>
        )}
      </div>
    </div>
  </div>
</Section>

<style>
  .bracket-shell { position: relative; }

  .bracket-viewport {
    width: 100%;
    overflow-x: auto;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-card);
    background-color: var(--c-bg-elev);
    scrollbar-color: var(--c-line-strong) transparent;
    scrollbar-width: thin;
  }

  .bracket-viewport:focus-visible {
    outline: 2px solid var(--c-accent-lift);
    outline-offset: 4px;
  }

  .bracket-board {
    --upper-path: 30.5%;
    --lower-path: 80.5%;
    position: relative;
    isolation: isolate;
    display: grid;
    width: max-content;
    min-width: 100%;
    grid-template-columns: 33.5rem 3rem 15.5rem 3rem 18rem;
    grid-template-rows: auto auto;
    justify-content: center;
    overflow: hidden;
    padding-inline: 1.5rem;
    background-image:
      linear-gradient(var(--c-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
    background-position: -1px -1px;
    background-size: 2.5rem 2.5rem;
  }

  .bracket-board::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 18% 22%, rgb(var(--c-brand-lift-rgb) / 0.11), transparent 28rem),
      radial-gradient(circle at 82% 50%, color-mix(in srgb, var(--c-accent) 11%, transparent), transparent 24rem),
      color-mix(in srgb, var(--c-bg-elev) 94%, transparent);
    content: "";
  }

  .bracket-track {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding-block: 3.5rem 1.75rem;
  }

  .track-upper { grid-column: 1; grid-row: 1; }

  .track-lower {
    grid-column: 1;
    grid-row: 2;
    border-top: 1px solid var(--c-line);
  }

  .track-final {
    grid-column: 3;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .bracket-side-label {
    position: absolute;
    top: 1.25rem;
    left: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-accent-lift);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .bracket-side-label > span {
    width: 1.5rem;
    height: 1px;
    background: currentColor;
  }

  .bracket {
    display: flex;
    align-items: stretch;
    gap: 2.5rem;
    min-width: max-content;
  }

  .bracket-round { display: flex; width: 15.5rem; flex-direction: column; }

  .bracket-head {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .bracket-body { display: flex; flex: 1; flex-direction: column; }

  .bracket-pair {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-around;
  }

  .bracket-match {
    position: relative;
    margin-block: 0.4375rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-control);
    background: var(--c-bg-elev);
    transition:
      border-color 220ms var(--ease-out-quint),
      background-color 220ms var(--ease-out-quint),
      box-shadow 260ms var(--ease-out-quint);
  }

  .bracket-match:hover {
    border-color: var(--c-line-strong);
    background: var(--c-bg-elev-2);
    box-shadow: 0 18px 36px -30px rgb(0 0 0 / 0.72);
  }

  .bracket-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid var(--c-line);
    padding: 0.375rem 0.625rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }

  .bracket-seat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-left: 2px solid transparent;
    padding: 0.4375rem 0.625rem;
    font-size: 0.8125rem;
    color: var(--c-text-muted);
  }
  .bracket-seat + .bracket-seat { border-top: 1px solid var(--c-line); }
  .bracket-seat.is-winner { border-left-color: var(--c-accent); color: var(--c-text); }

  .bracket-score { margin-left: auto; font-variant-numeric: tabular-nums; }
  .is-winner .bracket-score { color: var(--c-accent-lift); }

  .is-feeding .bracket-match::after,
  .is-feeding .bracket-pair::after,
  .is-feeding .bracket-pair.is-pair::before {
    content: "";
    position: absolute;
    background: var(--c-line-strong);
  }
  .is-feeding .bracket-match::after {
    top: 50%;
    left: 100%;
    height: 1px;
    width: 1.25rem;
  }
  .is-feeding .bracket-pair.is-pair::before {
    top: 25%;
    left: calc(100% + 1.25rem);
    height: 50%;
    width: 1px;
  }
  .is-feeding .bracket-pair::after {
    top: 50%;
    left: calc(100% + 1.25rem);
    height: 1px;
    width: 1.25rem;
  }

  .merge-connector {
    position: relative;
    z-index: 1;
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .merge-connector::before {
    position: absolute;
    top: var(--upper-path);
    bottom: calc(100% - var(--lower-path));
    left: 50%;
    width: 1px;
    background: linear-gradient(var(--c-line-strong), var(--c-accent-lift), var(--c-line-strong));
    content: "";
  }

  .merge-leg {
    position: absolute;
    height: 1px;
    background: var(--c-line-strong);
  }

  .merge-leg.is-upper { top: var(--upper-path); right: 50%; left: 0; }
  .merge-leg.is-lower { top: var(--lower-path); right: 50%; left: 0; }

  .merge-leg.is-output {
    top: 50%;
    right: 0;
    left: 50%;
    background: linear-gradient(90deg, var(--c-line-strong), var(--c-accent-lift));
  }

  .merge-leg.is-output::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--c-accent-lift);
    content: "";
    transform: translate(50%, -50%);
  }

  .champion-connector {
    position: relative;
    grid-column: 4;
    grid-row: 1 / span 2;
    align-self: center;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--c-line-strong), var(--c-accent-lift));
  }

  .champion-connector::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--c-accent-lift);
    content: "";
    transform: translate(50%, -50%);
  }

  .champion-card {
    --spot-x: 50%;
    --spot-y: 38%;
    position: relative;
    display: grid;
    grid-column: 5;
    grid-row: 1 / span 2;
    align-self: center;
    width: 18rem;
    min-height: 18rem;
    flex: none;
    place-items: center;
    align-content: center;
    gap: 1rem;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--c-accent-lift) 72%, var(--c-line));
    border-radius: var(--radius-card);
    background: var(--c-bg-elev);
    color: var(--c-accent-lift);
    box-shadow: 0 30px 72px -46px color-mix(in srgb, var(--c-accent-lift) 50%, transparent);
    text-align: center;
    transition:
      border-color 260ms var(--ease-out-quint),
      background-color 260ms var(--ease-out-quint),
      box-shadow 320ms var(--ease-out-quint);
  }

  .champion-card::before {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      20rem circle at var(--spot-x) var(--spot-y),
      color-mix(in srgb, var(--c-accent-lift) 22%, transparent),
      transparent 64%
    );
    content: "";
    opacity: 0.34;
    pointer-events: none;
    transition: opacity 280ms var(--ease-out-quint);
  }

  .champion-card::after {
    position: absolute;
    inset: 0.2rem 12% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-accent-lift), transparent);
    content: "";
    opacity: 0.85;
  }

  .champion-card:hover {
    border-color: var(--c-accent-lift);
    background-color: var(--c-bg-elev-2);
    box-shadow: 0 34px 80px -42px color-mix(in srgb, var(--c-accent-lift) 62%, transparent);
  }

  .champion-card:hover::before { opacity: 1; }

  .champion-card.is-crowned::before { opacity: 0.62; }
  .champion-card.is-crowned:hover::before { opacity: 1; }

  .champion-label,
  .champion-prize {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .champion-mark {
    position: relative;
    z-index: 1;
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--c-accent-lift) 64%, transparent);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--c-accent-lift) 8%, transparent);
  }

  .champion-mark > :global(svg) { width: 2.25rem; height: 2.25rem; }

  .champion-name {
    position: relative;
    z-index: 1;
    max-width: 14ch;
    color: var(--c-text);
    font-size: 1.5rem;
  }

  .champion-prize {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid color-mix(in srgb, var(--c-accent-lift) 52%, transparent);
    border-radius: var(--radius-control);
    letter-spacing: 0.08em;
  }

  .champion-prize :global(svg) { width: 0.875rem; height: 0.875rem; }

  @media (max-width: 639px) {
    .bracket-viewport { scroll-snap-type: x proximity; }

    .bracket-board {
      grid-template-columns: 30rem 2rem 14rem 2rem 16rem;
      justify-content: start;
      padding-inline: 1rem;
    }

    .bracket { gap: 2rem; }
    .bracket-round { width: 14rem; }

    .track-upper,
    .track-lower,
    .track-final,
    .champion-card { scroll-snap-align: center; }

    .is-feeding .bracket-match::after { width: 1rem; }

    .is-feeding .bracket-pair.is-pair::before,
    .is-feeding .bracket-pair::after { left: calc(100% + 1rem); }

    .is-feeding .bracket-pair::after { width: 1rem; }

    .champion-card { width: 16rem; min-height: 16rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bracket-match,
    .champion-card,
    .champion-card::before { transition: none; }
  }
</style>

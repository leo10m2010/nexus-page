---
import Section from "@ui/Section.astro";
import TeamMark from "@ui/TeamMark.astro";
import type { Participant, Tournament } from "@lib/competition";
import { formatDateRange, formatMoney } from "@lib/format";
import { useTranslations, resolveLocale } from "@lib/i18n";
import { channels, site } from "@config/site";

/* Overview = the payout table next to the fact panel, which is the shape a
   tournament page has settled into everywhere: the money is what people came
   to read, the panel is what they check afterwards. */
interface Props {
  id: string;
  tournament: Tournament;
  participants: Participant[];
}
const { id, tournament, participants } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;

const prize = tournament.prizePool;
const payouts = prize?.distribution ?? [];
const teamById = new Map(participants.map((p) => [p.team.id, p.team]));

/* Without a payout table the panel is the whole section, so it stops
   stretching to a full column and keeps its readable width. */
const layout = payouts.length ? "lg:grid-cols-[1fr_21rem]" : "max-w-[21rem]";

const rows: { label: string; value: string }[] = [
  { label: c.info.organizer, value: tournament.organizer ?? site.name },
  ...(tournament.venue ? [{ label: c.info.venue, value: c.venue[tournament.venue] }] : []),
  ...(tournament.location ? [{ label: c.info.location, value: tournament.location }] : []),
  { label: c.info.dates, value: formatDateRange(tournament.startDate, tournament.endDate, locale) },
  ...(prize
    ? [{ label: c.info.prizePool, value: formatMoney(prize.total, prize.currency, locale) }]
    : []),
  { label: c.info.teams, value: c.teamCount(tournament.teamCount) },
  { label: c.info.format, value: c.format[tournament.format] },
];
---

<Section id={id} bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">{c.section.overview}</h2>

  <div class={`grid-hairline mt-10 grid ${layout}`}>
    {/* Payouts. One row per place, ranges collapsed the way they are awarded. */}
    {
      payouts.length > 0 && (
        <div class="reveal bg-elev p-6 sm:p-8">
          <h3 class="display-sm text-sm text-accent-lift">{c.info.prizePool}</h3>

          <table class="mt-5 w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-line-strong">
                <th scope="col" class="th">{c.prizeHead.place}</th>
                <th scope="col" class="th text-right">{c.prizeHead.prize}</th>
                <th scope="col" class="th pl-6">{c.prizeHead.team}</th>
              </tr>
            </thead>
            <tbody>
              {payouts.map((row) => {
                const team = row.team ? (teamById.get(row.team) ?? null) : null;
                return (
                  <tr class="border-b border-line last:border-0">
                    <td
                      class={`py-3.5 font-display text-[0.9375rem] font-bold ${
                        row.place === 1 ? "text-accent-lift" : "text-ink"
                      }`}
                    >
                      {row.to ? c.placeRange(row.place, row.to) : c.place(row.place)}
                    </td>
                    <td class="py-3.5 text-right text-[0.9375rem] tabular-nums text-ink">
                      {formatMoney(row.amount, prize!.currency, locale)}
                    </td>
                    <td class="py-3.5 pl-6">
                      {team ? (
                        <span class="flex items-center gap-2.5">
                          <TeamMark team={team} size={24} />
                          <span class="truncate text-[0.9375rem]">{team.name}</span>
                        </span>
                      ) : row.to ? (
                        /* A shared place is several teams, so naming one here
                           would be wrong even after the tournament is over. */
                        <span class="text-[0.9375rem] text-muted" aria-hidden="true">&mdash;</span>
                      ) : (
                        <span class="text-[0.9375rem] text-muted">{c.tbd}</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }

    {/* The panel. Same facts as the header strip, in a form you can scan. */}
    <aside class="reveal bg-elev p-6 sm:p-8" style="--reveal-delay:80ms">
      <h3 class="display-sm text-sm text-accent-lift">{tournament.name}</h3>

      <dl class="mt-5">
        {
          rows.map((row) => (
            <div class="flex justify-between gap-6 border-b border-line py-3 last:border-0">
              <dt class="text-[0.8125rem] text-muted">{row.label}</dt>
              <dd class="text-right text-[0.9375rem]">{row.value}</dd>
            </div>
          ))
        }

        <div class="flex justify-between gap-6 py-3">
          <dt class="text-[0.8125rem] text-muted">{c.info.broadcast}</dt>
          <dd class="flex flex-wrap justify-end gap-2">
            {
              channels.map((channel) => (
                <a
                  href={channel.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-line-strong px-2 py-1 font-display text-[0.6875rem] font-bold tracking-[0.14em] uppercase transition-colors hover:border-accent hover:text-accent-lift"
                >
                  {channel.code}
                </a>
              ))
            }
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</Section>

<style>
  .th {
    padding-block: 0 0.75rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
</style>

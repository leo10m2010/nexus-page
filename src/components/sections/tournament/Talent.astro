---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import type { Tournament } from "@lib/competition";
import { useTranslations, resolveLocale } from "@lib/i18n";
import type { ChannelCode } from "@types";

interface Props {
  id: string;
  tournament: Tournament;
}
const { id, tournament } = Astro.props;

const PLATFORM_COLORS: Record<string, string> = {
  "simple-icons:kick": "#53fc18",
  "simple-icons:twitch": "#9146ff",
};
const LANGUAGE_FLAGS: Record<ChannelCode, string> = { es: "es", en: "us", ru: "ru" };

const talent = (tournament.broadcastTalent ?? []).map((person) => ({
  ...person,
  displayUrl: person.href.replace(/^https?:\/\//, "").replace(/\/$/, ""),
  brandColor: PLATFORM_COLORS[person.icon] ?? null,
  flag: LANGUAGE_FLAGS[person.language],
}));

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;
---

<Section id={id} bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">{c.section.talent}</h2>

  <ul class="talent-grid mt-10">
    {
      talent.map((person) => (
        <li>
          <a
            href={person.href}
            target="_blank"
            rel="noopener noreferrer"
            class="talent-card group"
            style={person.brandColor ? `--brand-color:${person.brandColor}` : undefined}
          >
            <span class="talent-platform" aria-hidden="true">
              <Icon name={person.icon} class="talent-icon" />
            </span>

            <span class="talent-copy min-w-0">
              <span class="display-sm block truncate text-base">{person.name}</span>
              <span class="talent-url">
                {person.displayUrl.replace(/^www\./, "")}
              </span>
            </span>

            <span class="talent-language">
              <Icon name={`flag:${person.flag}-4x3`} aria-hidden="true" />
              <span>{t.channels.languages[person.language]}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .talent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1rem;
  }

  .talent-card {
    position: relative;
    display: grid;
    min-height: 6.5rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    overflow: hidden;
    padding: 1.25rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-card);
    background: var(--c-bg-elev);
    transition: border-color 0.25s var(--ease-out-quint), background-color 0.25s var(--ease-out-quint);
  }

  .talent-platform {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-control);
    background: var(--c-bg);
  }

  .talent-icon {
    width: 1.375rem;
    height: 1.375rem;
    color: var(--c-text-muted);
    transition: color 0.2s var(--ease-out-quint);
  }

  .talent-url {
    display: block;
    overflow: hidden;
    margin-top: 0.25rem;
    color: var(--c-text-muted);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .talent-language {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-control);
    color: var(--c-text-muted);
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .talent-language :global(svg) { width: 1.125rem; height: 0.84375rem; }

  .talent-card:hover { border-color: color-mix(in srgb, var(--brand-color, var(--c-accent-lift)) 52%, var(--c-line)); background: var(--c-bg-elev-2); }
  .group:hover .talent-icon { color: var(--brand-color, var(--c-accent-lift)); }

  @media (max-width: 420px) {
    .talent-card { grid-template-columns: auto minmax(0, 1fr); }
    .talent-language { grid-column: 2; justify-self: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .talent-card,
    .talent-icon { transition: none; }
  }
</style>

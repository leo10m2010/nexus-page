---
import { Icon } from "astro-icon/components";
import Section from "@ui/Section.astro";
import type { Tournament } from "@lib/competition";
import { useTranslations, resolveLocale } from "@lib/i18n";

interface Props {
  id: string;
  tournament: Tournament;
}
const { id, tournament } = Astro.props;
const talent = (tournament.broadcastTalent ?? []).map((person) => ({
  ...person,
  displayUrl: person.href.replace(/^https?:\/\//, "").replace(/\/$/, ""),
}));

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const c = t.competition;
---

<Section id={id} bordered>
  <h2 class="display reveal text-[clamp(1.75rem,3.4vw,2.75rem)]">{c.section.talent}</h2>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      talent.map((person) => (
        <li>
          <a
            href={person.href}
            target="_blank"
            rel="noopener noreferrer"
            class="card-tile group flex items-center gap-4 rounded-card p-5"
          >
            <Icon
              name={person.icon}
              class="size-7 shrink-0 text-muted transition-colors group-hover:text-accent-lift"
            />
            <span class="min-w-0">
              <span class="display-sm block truncate text-base">{person.name}</span>
              <span class="mt-0.5 block truncate text-[0.8125rem] text-accent-lift">
                {person.displayUrl}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
